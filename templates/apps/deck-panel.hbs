<div class="deck-body sensor-body">
  <section class="deck-head">
    <h3>{{name}} <small>Rating {{rating}} · Flux {{flux}} ({{range}})</small></h3>
    <p>
      {{#if connected}}<strong>Connected</strong> — operator {{operator}}
        <button type="button" data-action="disconnect" title="Jack out (no dump: Rigger 2 p.64)"><i class="fas fa-plug-circle-xmark"></i> Disconnect</button>
      {{else}}<strong>Disconnected</strong>
        <button type="button" data-action="connect"><i class="fas fa-plug"></i> Connect</button>
      {{/if}}
      · Subscribers {{subscribed}}/{{limits.subscribers}} · Affiliated {{affiliatedCount}}/{{limits.affiliated}} (Rigger 2 p.62, p.64)
      {{#if onVehicle}}{{#if hardwired}}<em>Hardwired to {{holderName}}</em>{{#if gm}} <button type="button" data-action="hardwire" data-on="0">Un-hardwire</button>{{/if}}
      {{else}}<button type="button" data-action="hardwire" data-on="1" title="Permanently affiliate the vehicle carrying this deck: rigger adaptation + an Electronics Port to the deck (p.64)"><i class="fas fa-link"></i> Hardwire</button>{{/if}}{{/if}}
      {{#if hasPrimary}}<button type="button" data-action="ret" title="Simple Action (p.65)"><i class="fas fa-chair"></i> Return to the captain's chair</button>{{/if}}
    </p>
  </section>
  <table class="deck-table">
    <thead><tr><th>Vehicle</th><th>Pilot</th><th>Status</th><th>Standing order</th><th></th></tr></thead>
    <tbody>
      {{#each rows}}
      <tr class="{{#if primary}}primary{{/if}}">
        <td>{{name}}{{#if hardwired}} <i class="fas fa-link" title="Hardwired"></i>{{/if}}</td>
        <td>{{pilot}}</td>
        <td>
          {{#if affiliated}}Affiliated{{#if mode}} · <strong>{{mode}}</strong>{{/if}}{{else}}Subscribed{{/if}}
          {{#unless reachable}} · <em title="Out of the deck's range: it acts on its last order or holds (p.64)">out of range</em>{{/unless}}
          {{#if sitsOut}} · <em title="Affiliated this Combat Turn: no actions until the next (ruling R5-1)">sits out this Turn</em>{{/if}}
        </td>
        <td>{{#if order}}"{{order.text}}" — {{order.successes}} success{{#unless (eq order.successes 1)}}es{{/unless}}{{/if}}</td>
        <td class="deck-actions">
          {{#if affiliated}}
            {{#unless hardwired}}<button type="button" data-action="affiliate" data-uuid="{{uuid}}" data-on="0" title="Simple Action (p.64)">Disaffiliate</button>{{/unless}}
            {{#if ../connected}}
              {{#unless primary}}<button type="button" data-action="jump" data-uuid="{{uuid}}" title="Simple Action; needs a VCR, jacked in (p.65)">Jump in</button>
              <button type="button" data-action="command" data-uuid="{{uuid}}" title="Complex Action: the drone's Comprehension Test (p.66)">Command</button>{{/unless}}
            {{/if}}
          {{else}}
            <button type="button" data-action="affiliate" data-uuid="{{uuid}}" data-on="1" title="Simple Action (p.64)">Affiliate</button>
            <button type="button" data-action="unsubscribe" data-uuid="{{uuid}}" title="Remove from the subscriber list">✖</button>
          {{/if}}
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5"><em>No subscribers yet.</em></td></tr>
      {{/each}}
    </tbody>
  </table>
  {{#if connected}}
  <section class="deck-ivis">
    <button type="button" data-action="groupCommand" title="Complex Action: one Comprehension Test at the group's lowest Pilot; an IVIS Test first if the deck has the master unit (p.66–67)"><i class="fas fa-users"></i> Group command</button>
    {{#each ivis}}
      <p>IVIS group: {{drones}} — "{{task}}" · pool {{balance}}/{{pool}}
        <button type="button" data-action="ivisEnd" data-gid="{{gid}}" title="The task is done or abandoned: the group and its pool end (p.67)">End task</button></p>
    {{/each}}
  </section>
  {{/if}}
  {{#if connected}}
  <section class="deck-ew">
    <h4>Electronic warfare <small>(Rigger 2 p.68–72)</small></h4>
    {{#if ew.any}}
    <table class="deck-table">
      <thead><tr><th>Channel</th><th>Signal</th><th>Intruders</th><th></th></tr></thead>
      <tbody>
        {{#each ew.channels}}
        <tr>
          <td>{{ch}}</td>
          <td>{{boxes}}/10 · {{band}}{{#if lost}} · <strong>carrier lost</strong>{{/if}}</td>
          <td>{{#each attackers}}{{name}}: {{n}} <button type="button" data-action="ewRegen" data-channel="{{../ch}}" data-key="{{key}}" title="Complex Action: ECCM rating vs their rating + 3; 2 successes clear a box (p.72)">Regenerate</button><br>{{/each}}</td>
          <td>{{#if lost}}<button type="button" data-action="ewReconnect" data-channel="{{ch}}" title="Control Systems vs TN 4 + the band + damage; successes must exceed the filled boxes (p.72)">Reconnect</button>{{/if}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{#each ew.bogus}}
      <p>Bogus object on the {{channel}} channel ({{by}}) — {{cancelled}}/{{net}} cancelled
        <button type="button" data-action="ewBlock" data-eid="{{eid}}" title="ECCM vs their protocol emulation (p.71, p.31)">Block</button></p>
    {{/each}}
    {{else}}<p><em>All channels clear.</em></p>{{/if}}
    {{#each ew.contests}}
      <p><strong>Interference contest</strong> with {{name}}: your system channel {{mine}}/10, theirs {{theirs}}/10 (p.72).
        <button type="button" data-action="ewInterfere" data-uuid="{{other}}" title="Complex Action: deck Flux vs their rating; the loser takes the net successes as boxes on its own system channel">Interfere</button></p>
    {{/each}}
    {{#if ew.alert}}<p><em>Alerted {{ew.alert}}× — every interception against this network is +{{ew.alert}}×2 TN (p.69).</em></p>{{/if}}
    {{#if ew.targets.length}}
    <p><strong>Other networks</strong></p>
    {{#each ew.targets}}
      <p>{{name}}{{#if encrypted}} <i class="fas fa-lock" title="Encrypted"></i>{{/if}} —
        {{#if intercepted}}intercepted: {{#each channels}}{{this}} <button type="button" data-action="ewRead" data-uuid="{{../uuid}}" data-channel="{{this}}" title="Complex Action: read it; they may detect you (p.69)">Read</button> {{/each}}
          <button type="button" data-action="ewMiji" data-uuid="{{uuid}}" title="Meaconing, intrusion or jamming (p.69–72)">MIJI…</button>
          {{#if systemHeld}}<button type="button" data-action="ewInterfere" data-uuid="{{uuid}}" title="Interference (p.72): fight for their whole network through its system channel">Interfere</button>{{/if}}
        {{else}}not intercepted{{/if}}
        {{#if gmChooses}}{{#if ../gm}}<button type="button" data-action="ewChoose" data-uuid="{{uuid}}">Choose {{gmChooses}} channel(s)</button>{{else}}<em>(the GM chooses {{gmChooses}} more)</em>{{/if}}{{/if}}
        {{#if encrypted}}<button type="button" data-action="ewDecrypt" data-uuid="{{uuid}}" title="Electronic Warfare + decryption vs encryption + 4 (p.69)">Break encryption</button>{{/if}}
        <button type="button" data-action="ewIntercept" data-uuid="{{uuid}}" title="Complex Action: deck rating vs their rating + 3 (p.68)">Intercept</button></p>
      {{#if held.length}}<p>&nbsp;&nbsp;You hold their {{#each held}}{{this}} {{/each}}channel (p.70).
        {{#each drones}}<button type="button" data-action="ewCommand" data-target="{{../uuid}}" data-uuid="{{uuid}}" title="Their drone's Comprehension Test, your skills">Command {{name}}</button> {{/each}}</p>{{/if}}
    {{/each}}
    {{/if}}
  </section>
  {{/if}}
  <p class="deck-add">
    <select name="newSub"><option value="">— targeted vehicles —</option>{{#each linked}}<option value="{{uuid}}">{{name}}</option>{{/each}}</select>
    <button type="button" data-action="subscribe"><i class="fas fa-plus"></i> Subscribe</button>
    <small>Editing the subscriber list is not an action (Rigger 2 p.62).</small>
  </p>
</div>
