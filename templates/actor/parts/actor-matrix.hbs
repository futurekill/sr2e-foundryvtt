<section class="tab-content {{#if tab.active}}active{{/if}}" data-tab="matrix" data-group="primary">
  <div class="matrix-section">

    {{!-- Cyberdeck Configuration --}}
    <fieldset class="cyberdeck-config">
      <legend>Cyberdeck</legend>
      {{#if deckInactiveHint}}<p class="hint sr2e-limb-warn">No deck is active, so these are the manual values. Equip (or ⚡ activate) a deck on the Gear tab to use its ratings.</p>{{/if}}
      <div class="cyberdeck-grid">
        <div class="form-group">
          <label>MPCP:</label>
          <input type="number" name="system.cyberdeck.mpcp" value="{{authoredDeck.mpcp}}" min="0" />{{#ifEquals authoredDeck.mpcp system.cyberdeck.mpcp}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.mpcp}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Hardening:</label>
          <input type="number" name="system.cyberdeck.hardening" value="{{authoredDeck.hardening}}" min="0" />{{#ifEquals authoredDeck.hardening system.cyberdeck.hardening}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.hardening}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Active Memory:</label>
          <input type="number" name="system.cyberdeck.activeMemory" value="{{authoredDeck.activeMemory}}" min="0" />{{#ifEquals authoredDeck.activeMemory system.cyberdeck.activeMemory}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.activeMemory}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Storage Memory:</label>
          <input type="number" name="system.cyberdeck.storageMemory" value="{{authoredDeck.storageMemory}}" min="0" />{{#ifEquals authoredDeck.storageMemory system.cyberdeck.storageMemory}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.storageMemory}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Load Speed:</label>
          <input type="number" name="system.cyberdeck.loadSpeed" value="{{authoredDeck.loadSpeed}}" min="0" />{{#ifEquals authoredDeck.loadSpeed system.cyberdeck.loadSpeed}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.loadSpeed}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>I/O Speed:</label>
          <input type="number" name="system.cyberdeck.ioSpeed" value="{{authoredDeck.ioSpeed}}" min="0" />{{#ifEquals authoredDeck.ioSpeed system.cyberdeck.ioSpeed}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.ioSpeed}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Response:</label>
          <input type="number" name="system.cyberdeck.response" value="{{authoredDeck.response}}" min="0" />{{#ifEquals authoredDeck.response system.cyberdeck.response}}{{else}}<span class="hint" title="From the active deck">→ {{system.cyberdeck.response}}</span>{{/ifEquals}}
        </div>
        {{#if vr2}}
        <div class="form-group">
          <label title="VR2.0 p.85: hot (full simsense), cool (legal-level signal; black IC can't kill), tortoise (no ASIST)">ASIST:</label>
          <select name="system.cyberdeck.deckMode">
            <option value="hot" {{selected authoredDeck.deckMode "hot"}}>Hot</option>
            <option value="cool" {{selected authoredDeck.deckMode "cool"}}>Cool</option>
            <option value="tortoise" {{selected authoredDeck.deckMode "tortoise"}}>Tortoise</option>
          </select>
        </div>
        <div class="form-group">
          <label title="No manual controls (VR2.0 p.85): another level of Response Increase; +2 to simsense-overload TNs">DNI only:</label>
          <input type="checkbox" name="system.cyberdeck.dniOnly" {{checked authoredDeck.dniOnly}} />
        </div>
        <div class="form-group">
          <label title="ICCM filter: −2 to simsense-overload TNs; −2 Power and −1 level of dump shock (VR2.0 p.124)">ICCM:</label>
          <input type="checkbox" name="system.cyberdeck.iccm" {{checked authoredDeck.iccm}} />
        </div>
        {{/if}}
      </div>
    </fieldset>

    {{!-- Matrix Persona --}}
    {{#if isDecker}}

    {{!-- Jack in / out + dump shock --}}
    <div class="matrix-status flexrow" style="align-items:center;gap:10px;margin-bottom:6px;">
      <button type="button" data-action="toggleMatrixMode"
              class="{{#if system.matrixMode}}active{{/if}}"
              title="Jack in / jack out of the Matrix (controls Matrix initiative).">
        <i class="fas fa-plug"></i>
        {{#if system.matrixMode}}Jacked In{{else}}Jacked Out{{/if}}
      </button>
      {{#if system.matrixMode}}
      <button type="button" data-action="matrixAttack" title="{{#if vr2}}Attack with a loaded attack utility vs the Cybercombat Target Numbers Table (VR2.0 p.123){{else}}Make a Matrix attack with a loaded Attack program (SR2E p.178){{/if}}.">
        <i class="fas fa-bolt"></i> Matrix Attack
      </button>
      <button type="button" data-action="systemOperation" title="{{#if vr2}}A System Test against a host subsystem (VR2.0 p.19){{else}}Run a system operation against a host/node (SR2E p.166){{/if}}.">
        <i class="fas fa-terminal"></i> System Operation
      </button>
      {{#if vr2}}
      <button type="button" data-action="vr2Maneuver" title="Evade detection, parry or position against the targeted icon: Evasion vs its Sensor, opposed (VR2.0 p.122).">
        <i class="fas fa-shuffle"></i> Maneuver
      </button>
      <button type="button" data-action="vr2ScanIcon" title="Scan the targeted icon: Computer vs its Masking less your Scanner (Sleaze counts against you); each success buys one fact (VR2.0 p.117).">
        <i class="fas fa-magnifying-glass"></i> Scan Icon
      </button>
      <button type="button" data-action="vr2Improvise" title="Write a one-shot attack program from Evasion and Bod points (VR2.0 p.123).">
        <i class="fas fa-code"></i> Improvise
      </button>
      {{#if vr2LostSight}}
      <button type="button" data-action="vr2Redetect" title="After a successful Analyze Icon or Locate Decker: find the icons that evaded you again (p.122).">
        <i class="fas fa-eye"></i> Re-detect
      </button>
      {{/if}}
      {{/if}}
      {{/if}}
      {{#if vr2}}
      {{#if vr2Session}}
      <span class="vr2-tally" title="Security tally of this session's host: the host's System Test successes so far (VR2.0 p.19). The GM sets the trigger steps.">
        <i class="fas fa-shield-halved"></i> {{#if vr2Session.hostName}}{{vr2Session.hostName}}{{else}}Jackpoint{{/if}} tally:
        {{#if isGM}}<input type="number" name="flags.sr2e.vr2Session.tally" value="{{vr2Session.tally}}" min="0" style="width:44px;text-align:center;" />
        {{else}}<strong>{{vr2Session.tally}}</strong>{{/if}}
      </span>
      {{else if vr2LastSession}}
      <span class="vr2-tally" style="opacity:.7;" title="The last session's security tally (VR2.0 p.19).">
        Last session: {{vr2LastSession.hostName}} tally {{vr2LastSession.tally}}
      </span>
      {{/if}}
      {{else if system.dumpShock}}
      <span class="dump-shock" style="color:#c44;font-weight:bold;" title="+2 to all TNs until shaken off.">
        <i class="fas fa-skull"></i> Dump Shock
      </span>
      <button type="button" data-action="recoverDumpShock" title="Willpower Test vs TN 4 to shake off dump shock (SR2E p.180).">
        Shake Off
      </button>
      {{/if}}
    </div>
    {{#if vr2Topo}}
    <div class="flexrow vr2-topo-row" style="align-items:center;gap:10px;margin-bottom:6px;flex-wrap:wrap;">
      {{#if vr2Topo.connected}}
      <span class="vr2-place" title="Where the decker is on the grids (VR2.0 p.14–30): logons go only where the book allows from here.">
        <i class="fas fa-network-wired"></i> {{#if vr2Topo.place}}On {{vr2Topo.place}}{{else}}At the jackpoint{{/if}}
      </span>
      {{#if vr2Topo.disconnect}}<button type="button" data-action="vr2Disconnect" title="Disconnect from this host and go back to its grid, without ending the run: no test (VR2.0 p.14).">
        <i class="fas fa-arrow-up-from-bracket"></i> Disconnect to grid</button>{{/if}}
      {{/if}}
      {{#if (and isGM vr2Topo.known.length)}}
      <details class="vr2-known"><summary title="Unlisted addresses this decker knows (VR2.0 p.114): found by Locate Access Node, or told by the GM.">Known addresses</summary>
        {{#each vr2Topo.known as |k|}}<label style="display:block;"><input type="checkbox" name="flags.sr2e.vr2Known.{{k.id}}" {{checked k.known}} /> {{k.name}}</label>{{/each}}
      </details>
      {{/if}}
    </div>
    {{/if}}

    {{#if vr2}}{{#if vr2Session}}
    {{#if vr2Improvised}}
    <p class="rule-note"><i class="fas fa-code"></i> Improvised attack: {{#if vr2Improvised.level}}Power {{vr2Improvised.power}}, {{vr2Improvised.level}} — ready (one-shot){{else}}build failed{{/if}};
      Bod −{{vr2Improvised.bod}}, Evasion −{{vr2Improvised.evasion}} until it's used (p.123).</p>
    {{/if}}
    {{#each vr2Suppressed as |sup|}}
    <p class="rule-note"><i class="fas fa-ghost"></i> Suppressed: <strong>{{sup.name}}</strong> (rating {{sup.rating}}, Detection Factor −1)
      <button type="button" data-action="vr2Release" data-key="{{sup.key}}" title="Release it: +1 Detection Factor, +{{sup.rating}} to the tally (VR2.0 p.40).">Release</button></p>
    {{/each}}
    {{/if}}{{/if}}
    {{#if vr2ic}}{{> "systems/sr2e/templates/actor/parts/vr2-ic.hbs" ic=vr2ic}}{{/if}}

    <fieldset class="persona-config">
      <legend>Persona</legend>
      {{#if personaBudget}}
      <p class="alert-note passive"><i class="fas fa-triangle-exclamation"></i> Persona programs total {{personaBudget.bems}},
        over the MPCP × 3 limit of {{personaBudget.cap}} (VR2.0 p.84).</p>
      {{/if}}
      <div class="persona-grid">
        <div class="form-group">
          <label>Bod:</label>
          <input type="number" name="system.matrixPersona.bod" value="{{authoredPersona.bod}}" min="0" />{{#ifEquals authoredPersona.bod system.matrixPersona.bod}}{{else}}<span class="hint" title="Effective: loaded programs, icon damage, an improvised build">→ {{system.matrixPersona.bod}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Evasion:</label>
          <input type="number" name="system.matrixPersona.evasion" value="{{authoredPersona.evasion}}" min="0" />{{#ifEquals authoredPersona.evasion system.matrixPersona.evasion}}{{else}}<span class="hint" title="Effective: loaded programs, icon damage, an improvised build">→ {{system.matrixPersona.evasion}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Masking:</label>
          <input type="number" name="system.matrixPersona.masking" value="{{authoredPersona.masking}}" min="0" />{{#ifEquals authoredPersona.masking system.matrixPersona.masking}}{{else}}<span class="hint" title="Effective: loaded programs, icon damage, an improvised build">→ {{system.matrixPersona.masking}}</span>{{/ifEquals}}
        </div>
        <div class="form-group">
          <label>Sensor:</label>
          <input type="number" name="system.matrixPersona.sensor" value="{{authoredPersona.sensor}}" min="0" />{{#ifEquals authoredPersona.sensor system.matrixPersona.sensor}}{{else}}<span class="hint" title="Effective: loaded programs, icon damage, an improvised build">→ {{system.matrixPersona.sensor}}</span>{{/ifEquals}}
        </div>
      </div>
      <div class="form-group matrix-icon" style="margin-top:6px;">
        <label title="The persona token's image when this decker jacks in at a jackpoint (VR2.0 p.84). Blank: the token image.">Matrix icon:</label>
        <div class="flexrow" style="align-items:center;gap:6px;">
          <img src="{{#if system.matrixIcon}}{{system.matrixIcon}}{{else}}{{actor.prototypeToken.texture.src}}{{/if}}" alt="Matrix icon"
               data-action="editImage" data-edit="system.matrixIcon" title="Choose the Matrix icon"
               style="flex:0 0 36px;width:36px;height:36px;object-fit:contain;cursor:pointer;border:1px solid #33ddff55;border-radius:4px;" />
          <input type="text" name="system.matrixIcon" value="{{system.matrixIcon}}" placeholder="Blank: the token image" />
        </div>
      </div>
      <div class="form-group" style="margin-top:6px;">
        <label>Persona Condition <span style="font-size:10px;color:#aaa1c0;">(10 = crash)</span>:</label>
        <div class="flexrow" style="align-items:center;gap:6px;">
          <input type="number" name="system.matrixPersona.condition.value"
                 value="{{system.matrixPersona.condition.value}}" min="0" max="{{system.matrixPersona.condition.max}}"
                 style="width:52px;text-align:center;" />
          <span>/ {{system.matrixPersona.condition.max}}</span>
        </div>
      </div>
    </fieldset>

    {{!-- Hacking Pool --}}
    <fieldset class="hacking-pool">
      <legend>Hacking Pool</legend>
      <div class="pool-row flexrow">
        <input type="number" name="system.dicePools.hacking.value" value="{{system.dicePools.hacking.value}}" min="0" max="{{system.dicePools.hacking.max}}" />
        <span>/ {{system.dicePools.hacking.max}}</span>
      </div>
    </fieldset>

    {{!-- Programs --}}
    <div class="programs-category">
      <div class="category-header flexrow">
        <h3>Programs</h3>
        {{#if vr2}}<button type="button" data-action="vr2ic" data-op="programNew" class="btn-add" title="Write a new program: an unwritten project you design, then program (VR2.0 p.100)">
          <i class="fas fa-code"></i>
        </button>{{/if}}
        <button type="button" data-action="addItem" data-type="program" class="btn-add" title="Add a program you already have">
          <i class="fas fa-plus"></i>
        </button>
      </div>
      <div class="item-list">
        {{#each programs as |program|}}
        <div class="item-row program-row flexrow" data-item-id="{{program.id}}">
          <span class="item-name" data-action="rollProgram">
            <i class="fas fa-microchip"></i>
            {{program.name}}
          </span>
          <span>{{program.system.category}}</span>
          <span>Rating: {{#if ../vr2}}{{program.system.effectiveRating}}{{#if program.system.crashed}} (crashed){{/if}}{{#ifEquals program.system.effectiveRating program.system.rating}}{{else}} of {{program.system.rating}}{{/ifEquals}}{{else}}{{program.system.rating}}{{/if}}</span>
          <span>Size: {{program.system.size}}</span>
          <span>{{#if program.system.loaded}}<i class="fas fa-check text-success"></i> Loaded{{/if}}
            {{#if program.compressed}}<em title="Squeeze (VR2.0 p.104): decompress it (a Complex Action) before use">compressed</em>{{/if}}
            {{#if program.spent}}<em title="One-shot (p.104): fired; Swap Memory reloads it">spent</em>{{/if}}
            {{#if program.hasDinab}}<em title="DINAB rating left on this load (p.103)">DINAB {{program.dinab}}</em>{{/if}}
            {{#if program.task.writing}}<em title="Programming (p.100–102)">writing{{#if program.task.period}} {{program.task.done}}/{{program.task.period}}d{{/if}}</em>{{/if}}{{#if program.task.unwritten}}<em title="Its programming failed or was abandoned: it was never written (p.100). Start programming again.">unwritten</em>{{/if}}</span>
          <div class="item-controls">
            <a data-action="toggleEquip" title="Load/Unload"><i class="fas fa-power-off"></i></a>
            {{#if ../vr2}}<a data-action="vr2SwapMemory" title="Swap Memory: a fresh copy at full rating (VR2.0 p.99)"><i class="fas fa-rotate"></i></a>
            {{#if program.isMedic}}<a data-action="vr2Medic" title="Medic: repair the icon (a Complex Action, VR2.0 p.100)"><i class="fas fa-kit-medical"></i></a>{{/if}}
            {{#if program.compressed}}<a data-action="vr2ic" data-op="decompress" data-arg="{{program.id}}" title="Decompress (a Complex Action, VR2.0 p.104)"><i class="fas fa-up-right-and-down-left-from-center"></i></a>{{/if}}
            <a data-action="vr2ic" data-op="programming" data-arg="{{program.id}}" title="Programming: write this program (VR2.0 p.100–102)"><i class="fas fa-code"></i></a>
            {{#if program.task.writing}}<a data-action="vr2ic" data-op="programAbandon" data-arg="{{program.id}}" title="Abandon the programming task"><i class="fas fa-ban"></i></a>{{/if}}
            {{#if program.isRestore}}<a data-action="vr2ic" data-op="restore" data-arg="{{program.id}}" title="Restore: repair icon attribute damage (VR2.0 p.100)"><i class="fas fa-wand-magic-sparkles"></i></a>{{/if}}
            {{#if program.isEvaluate}}{{#if program.system.degradation}}<a data-action="vr2ic" data-op="evalRestore" data-arg="{{program.id}}" title="Decayed −{{program.system.degradation}} (VR2.0 p.97): restore with Karma, 1 per point"><i class="fas fa-arrow-trend-up"></i> −{{program.system.degradation}}</a>{{/if}}{{/if}}{{/if}}
            <a data-action="editItem"><i class="fas fa-edit"></i></a>
            <a data-action="deleteItem"><i class="fas fa-trash"></i></a>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

  </div>
</section>
