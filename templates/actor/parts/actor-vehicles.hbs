<section class="tab-content {{#if tab.active}}active{{/if}}" data-tab="vehicles" data-group="primary">
  <div class="vehicles-section">

    {{!-- Rigger Stats: VCR + Control Pool --}}
    <fieldset class="rigger-stats">
      <legend>Rigger</legend>
      <div class="rigger-stats-row flexrow">
        <div class="rigger-stat">
          <label>Vehicle Control Rig</label>
          {{#if vcrFromCyberware}}
          <span class="vcr-display" title="Set by the installed Vehicle Control Rig cyberware (Gear tab) — edit or remove the item to change it">
            {{system.vehicleControlRig}} <i class="fas fa-microchip" style="font-size:10px;opacity:0.7;"></i>
          </span>
          {{else}}
          <input type="number" name="system.vehicleControlRig" value="{{system.vehicleControlRig}}" min="0" max="3" class="vcr-input"
                 title="Manual rig level — installing Vehicle Control Rig cyberware will override this" />
          {{/if}}
        </div>
        {{#if isRigger}}
        <div class="rigger-stat">
          <label>Control Pool</label>
          <div class="pool-display flexrow">
            <input type="number" name="system.dicePools.control.value" value="{{system.dicePools.control.value}}" min="0" max="{{system.dicePools.control.max}}" class="pool-input" />
            <span class="pool-max">/ {{system.dicePools.control.max}}</span>
          </div>
        </div>
        <div class="rigger-stat">
          <label title="While jacked in, initiative uses ONLY the VCR's bonuses: Reaction +2 and +1d6 per level (SR2E p.85)">Jacked In</label>
          <button type="button" data-action="toggleRigging"
                  class="btn-small rigging-toggle {{#if system.rigging}}active{{/if}}">
            <i class="fas fa-plug"></i> {{#if system.rigging}}Rigging{{else}}Off{{/if}}
          </button>
        </div>
        {{/if}}
      </div>
      {{#if (or rigger2 hasVertigo)}}
      <div class="rigger-stats-row flexrow rigger-toggles">
        {{#if system.vcrSwitchable}}
        <label title="Rigger 2 p.17: a reflex-triggered VCR switched off (a Simple Action) is no VCR at all — no rigging, Control Pool or Reaction bonus, and no decking penalty">
          <input type="checkbox" name="system.vcrOff" {{checked system.vcrOff}}> VCR switched off</label>
        {{/if}}
        {{#if (and rigger2 (or vcrFromCyberware system.vehicleControlRig))}}
        <label title="Rigger 2 p.16–17: a second, decker datajack bypasses the VCR — no +1 TN while decking and no Hacking Pool cut">
          <input type="checkbox" name="system.deckerJack" {{checked system.deckerJack}}> Decker datajack</label>
        {{/if}}
        {{#if hasVertigo}}
        <label title="Simsense Vertigo (Rigger 2 p.15): +1 to all TNs and −1 Initiative while operating a simsense device. Rigging, decking and smartlinked attacks count by themselves; tick this for anything else (display link, simrig, a smartlinked weapon held ready)">
          <input type="checkbox" name="system.usingSimsense" {{checked system.usingSimsense}}> Using simsense (Vertigo)</label>
        {{/if}}
      </div>
      {{/if}}
    </fieldset>

    <div class="vehicles-instructions">
      <p>Drag a Vehicle or Drone actor from the sidebar to link it, or
        <button type="button" class="btn-small" data-action="openWorkshop" title="Design one from scratch with the Rigger 2 rules; it's linked to this character when you create it">
          <i class="fas fa-screwdriver-wrench"></i> Design a vehicle</button>
        {{#if rigger2}}<button type="button" class="btn-small" data-action="openOverhead" title="Rigger 2 p.18–19: pay your vehicles' monthly overhead (Lifestyle credit, Good Karma) and restore missed months">
          <i class="fas fa-file-invoice-dollar"></i> Overhead</button>{{/if}}</p>
    </div>

    {{#if linkedVehicles.length}}
    <div class="vehicle-list">
      {{#each linkedVehicles as |vehicle|}}
      <div class="vehicle-card" data-vehicle-uuid="{{vehicle.uuid}}">

        {{!-- Vehicle Header --}}
        <div class="vehicle-card-header flexrow">
          <img src="{{vehicle.img}}" alt="{{vehicle.name}}" class="vehicle-portrait-thumb" />
          <div class="vehicle-card-title">
            <span class="vehicle-name">{{vehicle.name}}</span>
            <span class="vehicle-type">{{vehicle.system.vehicleType}}</span>
          </div>
          <div class="vehicle-card-controls">
            <a class="vehicle-ctrl-btn {{#if vehicle.controlled}}active{{/if}}" data-action="toggleVehicleControl"
               title="{{#if vehicle.controlled}}You are driving / rigging this vehicle. Click to let go.{{else}}Take control: you drive or rig it now (its Crash Tests, Control Pool and rigged initiative come to you).{{/if}}">
              <i class="fas fa-steering-wheel fa-gamepad"></i> {{#if vehicle.controlled}}Driving{{else}}Control{{/if}}
            </a>
            {{#if vehicle.r2}}
            <a class="vehicle-ctrl-btn" data-action="drivingTest"
               title="Rigger 2 Driving Test (p.20–21): any maneuver that needs a test, in or out of combat">
              <i class="fas fa-road"></i> Drive
            </a>
            {{/if}}
            <a class="vehicle-ctrl-btn" data-action="vehicleTest"
               title="{{#if vehicle.r2}}Position / Crash Test — core rules (Rigger 2 vehicle combat comes in a later release){{else}}Handling / Position / Crash Test (SR2E p.105–107){{/if}}">
              <i class="fas fa-tachometer-alt"></i> {{#if vehicle.r2}}Combat (core){{else}}Test{{/if}}
            </a>
            <a class="vehicle-ctrl-btn" data-action="ramVehicle"
               title="Ram another vehicle — target its token to pre-fill stats (SR2E p.107)">
              <i class="fas fa-car-burst"></i> Ram
            </a>
            <a class="vehicle-ctrl-btn" data-action="escapeTest"
               title="Escape Test as pursuer (SR2E p.107)">
              <i class="fas fa-person-running"></i> Escape
            </a>
            <a class="vehicle-ctrl-btn" data-action="vehicleHitObject"
               title="Hit a wall or a barrier (SR2E p.109)">
              <i class="fas fa-road-barrier"></i> Hit
            </a>
            {{#if vehicle.hasAutopilot}}
            <a class="vehicle-ctrl-btn" data-action="autopilotCommand"
               title="Give the autopilot a command; the GM sets the TN (SR2E p.104–105)">
              <i class="fas fa-robot"></i> Command
            </a>
            {{/if}}
            <a class="vehicle-ctrl-btn" data-action="openVehicle" title="Open Sheet">
              <i class="fas fa-external-link-alt"></i> Sheet
            </a>
            <a class="vehicle-ctrl-btn remove" data-action="unlinkVehicle" title="Remove from character">
              <i class="fas fa-times"></i> Remove
            </a>
          </div>
        </div>

        {{!-- Vehicle Stats --}}
        <div class="vehicle-stats-row flexrow">
          <span class="vehicle-stat" title="Handling">Hand: {{vehicle.system.effectiveHandling}}</span>
          {{#if vehicle.r2}}
          <span class="vehicle-stat" title="Rigger 2 Speed Rating (after damage), max ×1.5 (p.22)">Spd: {{vehicle.r2.speed}}/{{vehicle.r2.maxSpeed}} ({{vehicle.r2.kph}} km/h)</span>
          <span class="vehicle-stat" title="Stress (Rigger 2 p.25){{#if vehicle.r2.permanent}}; {{vehicle.r2.permanent}} permanent{{/if}}">Stress: {{vehicle.r2.stress}}</span>
          {{else}}
          <span class="vehicle-stat" title="Cruising speed in m/Combat Turn (after damage); ×1.2 = km/h (SR2E p.104)">Spd: {{vehicle.system.effectiveSpeed}} ({{vehicle.kph}} km/h)</span>
          {{/if}}
          <span class="vehicle-stat" title="Acceleration">Acc: {{vehicle.system.effectiveAcceleration}}</span>
          <span class="vehicle-stat" title="Body">Body: {{vehicle.system.body}}</span>
          <span class="vehicle-stat" title="Armor">Armor: {{vehicle.system.effectiveArmor}}</span>
          <span class="vehicle-stat" title="Pilot">Pilot: {{vehicle.system.effective.pilot}}</span>
          <span class="vehicle-stat" title="Sensor">Sensor: {{vehicle.system.effective.sensor}}</span>
          <span class="vehicle-stat" title="Signature">Sig: {{vehicle.system.effectiveSignature}}</span>
        </div>

        {{!-- Vehicle Condition Monitor --}}
        <div class="vehicle-condition">
          <div class="monitor-row flexrow">
            <span class="condition-label">Condition:</span>
            <button type="button" class="monitor-btn" data-action="decrementVehicleMonitor">−</button>
            <span class="monitor-value">{{vehicle.system.conditionMonitor.value}}</span>
            <span class="monitor-sep">/ {{vehicle.system.conditionMonitor.max}}</span>
            <button type="button" class="monitor-btn" data-action="incrementVehicleMonitor">+</button>
            <span class="vehicle-damage-level {{woundLevelClass vehicle.system.damageLevel}}"
                  title="Vehicle damage: TN +{{vehicle.system.damageTnMod}}, Initiative {{vehicle.system.damageInitMod}}, Speed {{vehicle.system.effectiveSpeed}} (SR2E p.109)">
              {{vehicle.system.damageLevel}}
            </span>
          </div>
          {{{conditionMonitor vehicle.system.conditionMonitor.value vehicle.system.conditionMonitor.max}}}
        </div>

        {{!-- Vehicle Weapons --}}
        {{#if vehicle.weapons.length}}
        <div class="vehicle-weapons">
          <h4>Weapons</h4>
          <div class="item-list">
            {{#each vehicle.weapons as |weapon|}}
            <div class="item-row weapon-row flexrow" data-weapon-id="{{weapon.id}}">
              <span class="item-name" data-action="rollVehicleWeapon"
                    title="Fire with your Gunnery skill (SR2E p.105)">
                <i class="fas fa-crosshairs"></i>
                {{weapon.name}}
              </span>
              <span class="weapon-type">{{weapon.system.weaponType}}</span>
              <span class="weapon-damage">{{weapon.system.damageCode}}</span>
              {{#ifEquals weapon.system.weaponType "firearm"}}
              <span class="weapon-ammo">{{weapon.system.ammo.current}}/{{weapon.system.ammo.max}}</span>
              {{/ifEquals}}
              <span class="weapon-modes">
                {{#if weapon.system.firingModes.ss}}SS {{/if}}
                {{#if weapon.system.firingModes.sa}}SA {{/if}}
                {{#if weapon.system.firingModes.bf}}BF {{/if}}
                {{#if weapon.system.firingModes.fa}}FA {{/if}}
              </span>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}

      </div>
      {{/each}}
    </div>

    {{else}}
    <div class="vehicles-empty">
      <i class="fas fa-car fa-3x"></i>
      <p>No vehicles or drones linked.</p>
    </div>
    {{/if}}

  </div>
</section>
