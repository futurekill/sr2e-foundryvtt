<section class="sr2e-matrix-sheet sr2e-host-sheet">
  <header class="sr2e-matrix-header">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Click to change portrait" style="cursor:pointer;" />
    <div class="title-block">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Node Name" class="actor-name" />
      <span class="subtitle">Matrix Host / Node</span>
    </div>
    <div class="rating-badge">
      <span class="code code-{{system.securityCode}}">{{localize (lookup (lookup config.securityCodes system.securityCode) "label")}}</span>
      <span class="num">{{system.systemRating}}</span>
    </div>
  </header>

  <div class="field-grid">
    <label class="field">
      <span>Security Code</span>
      <select name="system.securityCode">
        {{#each config.securityCodes as |sec key|}}
        <option value="{{key}}" {{selected ../system.securityCode key}}>{{localize sec.label}}</option>
        {{/each}}
      </select>
    </label>
    <label class="field">
      <span>System Rating <em>(TN)</em></span>
      <input type="number" name="system.systemRating" value="{{system.systemRating}}" min="1" />
    </label>
  </div>

  {{#unless vr2}}
  <p class="rule-note">
    A decker must beat <strong>{{successesNeeded}}</strong>
    success{{#ifEquals successesNeeded 1}}{{else}}es{{/ifEquals}} on a Computer Test
    (TN {{system.systemRating}}) to make this node execute an operation (SR2E p.165).
  </p>
  {{/unless}}

  {{#if vr2}}
  <fieldset class="vr2-subsystems">
    <legend>Subsystems (VR2.0 p.16)</legend>
    <div class="field-grid">
      {{#each subsystems as |sub|}}
      <label class="field"><span>{{sub.label}}</span>
        <input type="number" name="system.subsystems.{{sub.key}}" value="{{sub.value}}" min="0" /></label>
      {{/each}}
      <label class="field" title="The host's dice for System Tests and IC, and the dump-shock Power. 0 = the System Rating.">
        <span>Security Value <em>({{system.securityValue}})</em></span>
        <input type="number" name="system.securityValueOverride" value="{{system.securityValueOverride}}" min="0" /></label>
      <label class="field" title="Who made the mainframe: a Sensitive utility of another maker is useless here (VR2.0 p.104). Blank = no restriction.">
        <span>Manufacturer</span>
        <input type="text" name="system.manufacturer" value="{{system.manufacturer}}" /></label>
    </div>
    <div class="field-grid">
      <label class="field" title="Probe IC (VR2.0 p.42): on every System Test, this many dice against the decker's Detection Factor, onto the tally.">
        <span>Probe IC rating</span><input type="number" name="system.probe" value="{{system.probe}}" min="0" /></label>
    </div>
    <p class="rule-note"><strong>Shutdown</strong> (p.53):
      {{#if shutdown}}{{#if shutdown.offline}}<strong>shut down</strong>{{else}}{{shutdown.left}} of {{shutdown.turns}} Combat Turns left (final warning at {{shutdown.warning}}){{/if}}
        {{#if shutdown.manual}}{{#unless shutdown.offline}}<button type="button" data-action="vr2ic" data-op="shutdownAdvance" title="End a Combat Turn (no combat is counting it)">Next turn</button>{{/unless}}{{/if}}
        <button type="button" data-action="vr2ic" data-op="shutdownReset" title="Bring the host back up">Reset</button>
      {{else}}running. <button type="button" data-action="vr2ic" data-op="shutdownStart" title="Start the shutdown sequence by hand (a sheaf step does it automatically)">Start shutdown</button>{{/if}}</p>
    <p class="rule-note"><strong>Security sheaf</strong> (p.150):
      {{#each sheaf as |row|}}<br>{{row.step}}: {{row.label}}{{#if row.note}} — {{row.note}}{{/if}}
        <a data-action="hostSheafRemove" data-id="{{row.id}}" title="Remove this step"><i class="fas fa-trash"></i></a>
      {{else}} no steps.{{/each}}
      <br><button type="button" data-action="hostSheafAdd"><i class="fas fa-plus"></i> Add step</button></p>
    {{#if grid}}
    <fieldset class="vr2-grid">
      <legend>Grid (VR2.0 p.14–30)</legend>
      <div class="field-grid">
        <label class="field"><span>Kind</span>
          <select name="system.kind">{{#each grid.kinds as |label key|}}<option value="{{key}}" {{selected ../system.kind key}}>{{label}}</option>{{/each}}</select></label>
        {{#if grid.hasGrid}}
        <label class="field" title="{{#if grid.isLtg}}The RTG this LTG belongs to.{{else}}The LTG or PLTG this host is attached to (open access). Leave empty for a second-tier host reached only through its links.{{/if}}">
          <span>{{#if grid.isLtg}}Parent RTG{{else}}Attached to{{/if}}</span>
          <select name="system.grid"><option value="">—</option>{{#each grid.gridChoices as |g|}}<option value="{{g.uuid}}" {{selected ../system.grid g.uuid}}>{{g.name}}</option>{{/each}}</select></label>
        {{/if}}
        <label class="field" title="Its address isn't public: a decker must find it with Locate Access Node, or be told (p.114)."><span>Unlisted address</span>
          <input type="checkbox" name="system.unlisted" {{checked system.unlisted}} /></label>
        {{#if grid.variable}}
        <label class="field" title="Optional Variable LTG Ratings (p.28): −1, 0 or +1 to every System Rating."><span>Rating shift</span>
          <input type="number" name="system.ratingShift" value="{{system.ratingShift}}" min="-1" max="1" /></label>
        {{/if}}
      </div>
      {{#if grid.isHost}}
      <p class="rule-note"><strong>Linked hosts</strong> (tiered or host-host, p.14–15; links work both ways):
        {{#each grid.links as |l|}}<br>{{l.name}} <a data-action="grid" data-op="removeLink" data-arg="{{l.uuid}}" title="Remove the link"><i class="fas fa-trash"></i></a>{{/each}}
        {{#each grid.backLinks as |n|}}<br>{{n}} <em>(linked from there)</em>{{/each}}
        {{#if grid.linkChoices.length}}<br><select>{{#each grid.linkChoices as |c|}}<option value="{{c.uuid}}">{{c.name}}</option>{{/each}}</select>
        <button type="button" data-action="grid" data-op="addLink"><i class="fas fa-link"></i> Link</button>{{/if}}</p>
      {{/if}}
      {{#if grid.isPltg}}
      <p class="rule-note"><strong>Entry points</strong> (the LTGs this PLTG is entered from, p.28):
        {{#each grid.entries as |l|}}<br>{{l.name}} <a data-action="grid" data-op="removeEntry" data-arg="{{l.uuid}}" title="Remove"><i class="fas fa-trash"></i></a>{{/each}}
        {{#if grid.entryChoices.length}}<br><select>{{#each grid.entryChoices as |c|}}<option value="{{c.uuid}}">{{c.name}}</option>{{/each}}</select>
        <button type="button" data-action="grid" data-op="addEntry"><i class="fas fa-plus"></i> Add</button>{{/if}}</p>
      {{/if}}
      {{#if grid.isRtg}}<p class="rule-note">Its LTGs share one security tally, fired by this RTG's sheaf (p.29).
        <button type="button" data-action="grid" data-op="createLTG"><i class="fas fa-plus"></i> Create LTG</button></p>{{/if}}
      {{#if grid.isLtg}}<p class="rule-note">Under an RTG, this LTG's own sheaf is ignored: the RTG's fires (p.29).
        {{#if grid.variable}}<button type="button" data-action="grid" data-op="rollVariable"><i class="fas fa-dice"></i> Roll variable ratings</button>{{/if}}</p>{{/if}}
      <p class="rule-note"><strong>Reachable from here:</strong>
        {{#each grid.reach as |r|}}<br>{{r.op}}: {{r.name}}{{#if r.unlisted}} <em>(unlisted)</em>{{/if}}{{else}} nothing.{{/each}}</p>
    </fieldset>
    {{/if}}
    <p class="rule-note">Security tallies (the host's System Test successes, p.19):
      {{#each tallies as |t|}}<br><strong>{{t.name}}</strong>: {{t.tally}}{{else}}no decker in session.{{/each}}</p>
  </fieldset>
  {{/if}}

  <fieldset class="intrusion">
    <legend>Intrusion</legend>
    <div class="field-grid">
      <label class="field">
        <span>Alert</span>
        <select name="system.alert">
          {{#each config.alertStates as |label key|}}
          <option value="{{key}}" {{selected ../system.alert key}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="field">
        <span>Attempts</span>
        <input type="number" name="system.attempts" value="{{system.attempts}}" min="0" />
      </label>
    </div>
    <button type="button" class="reset-btn" data-action="resetHostTally" title="Reset the intrusion tally and clear the alert.">
      <i class="fas fa-rotate-left"></i> Reset Tally
    </button>
    {{#ifEquals system.alert "passive"}}
    {{#unless vr2}}<p class="alert-note passive"><i class="fas fa-triangle-exclamation"></i> Passive alert — all IC ratings +50% (SR2E p.168).</p>{{/unless}}
    {{/ifEquals}}
    {{#ifEquals system.alert "active"}}
    <p class="alert-note active"><i class="fas fa-bell"></i> Active alert — operators respond; the system may shut down.</p>
    {{/ifEquals}}
  </fieldset>

  <fieldset>
    <legend>Notes</legend>
    <div class="editor-content">{{{system.notes}}}</div>
    {{#if editable}}
    <textarea name="system.notes" style="display:none;">{{system.notes}}</textarea>
    {{/if}}
  </fieldset>
</section>
