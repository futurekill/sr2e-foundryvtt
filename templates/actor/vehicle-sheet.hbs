<section class="sr2e-vehicle-sheet tab-content {{#if tab.active}}active{{/if}}" data-tab="overview" data-group="primary">
  <div class="vehicle-header flexrow">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Click to change portrait" style="cursor:pointer;" class="profile-img" />
    <div class="header-info flexcol">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Vehicle Name" />
      <div class="form-group">
        <label>Type:</label>
        <select name="system.vehicleType">
          {{#each config.vehicleTypes as |label key|}}
          <option value="{{key}}" {{selected ../system.vehicleType key}}>{{localize label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-group">
        <label title="Driving skill used for vehicle tests; blank = type default (car / pilot)">Skill:</label>
        <input type="text" name="system.skill" value="{{system.skill}}"
               placeholder="{{system.drivingSkill}}" />
      </div>
    </div>
  </div>

  {{#if baseConvert}}
  <div class="sr2e-notice vehicle-base-notice">
    <p><strong>This vehicle was edited after it was designed.</strong> Since system 0.144.0 a vehicle stores its stats
      without its modifications and adds every mod's effect on top. These stats differ from what its design gives:</p>
    <ul>{{#each baseConvert.diff}}<li>{{field}}: stored {{stored}}, design {{design}}</li>{{/each}}</ul>
    <p>Until you choose, it works as before.</p>
    <button type="button" data-action="reapplyDesign">Reapply the design</button>
    <button type="button" data-action="keepAsEdited" title="It becomes a production vehicle with the stats it has now; its design mods become factory equipment">Keep as edited</button>
  </div>
  {{/if}}
  <fieldset class="vehicle-stats">
    <legend>Vehicle Statistics</legend>
    <div class="stat-grid">
      <div class="stat-item">
        <label title="On-road (or the only rating). Ground vehicles also have an off-road rating (Rigger 2 p.109).">Handling</label>
        <input type="number" name="system.handling" value="{{system.handling}}" />
        {{#if (ne system.effective.handling system.handling)}}<span class="stat-effective" title="With its modifications (base {{system.handling}})">→ {{system.effective.handling}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label title="Off-road Handling, for bikes and cars (Rigger 2 p.109). Blank for vehicles with one rating.">Off-road</label>
        <input type="number" name="system.handlingOffRoad" value="{{system.handlingOffRoad}}" placeholder="—" data-nullable />
        {{#if (ne system.effective.handlingOffRoad system.handlingOffRoad)}}<span class="stat-effective" title="With its modifications (base {{system.handlingOffRoad}})">→ {{system.effective.handlingOffRoad}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label title="Rigger 2 p.146: standard tires halve suspension and Handling modifications">Tires</label>
        <select name="system.tires">{{selectOptions tireChoices selected=system.tires}}</select>
      </div>
      <div class="stat-item">
        <label>Speed</label>
        <input type="number" name="system.speed" value="{{system.speed}}" />
        {{#if (ne system.effective.speed system.speed)}}<span class="stat-effective" title="With its modifications (base {{system.speed}})">→ {{system.effective.speed}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label title="Fixed-wing aircraft: the stall speed (Rigger 2 p.117). 0 for everything else.">Stall</label>
        <input type="number" name="system.stallSpeed" value="{{system.stallSpeed}}" />
      </div>
      <div class="stat-item">
        <label>Accel</label>
        <input type="number" name="system.acceleration" value="{{system.acceleration}}" />
        {{#if (ne system.effective.acceleration system.acceleration)}}<span class="stat-effective" title="With its modifications (base {{system.acceleration}})">→ {{system.effective.acceleration}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label>Body</label>
        <input type="number" name="system.body" value="{{system.body}}" />
      </div>
      <div class="stat-item">
        <label>Armor</label>
        <input type="number" name="system.armor" value="{{system.armor}}" />
        {{#if system.modArmor}}<span class="stat-effective" title="Base {{system.armor}} + {{system.modArmor}} from modifications">→ {{system.effectiveArmor}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label>Signature</label>
        <input type="number" name="system.signature" value="{{system.signature}}" />
        {{#if system.modSignature}}<span class="stat-effective" title="Base {{system.signature}} + {{system.modSignature}} from modifications">→ {{system.effectiveSignature}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label>Pilot</label>
        <input type="number" name="system.pilot" value="{{system.pilot}}" />
        {{#if (ne system.effective.pilot system.pilot)}}<span class="stat-effective" title="With its modifications (base {{system.pilot}})">→ {{system.effective.pilot}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label>Sensor</label>
        <input type="number" name="system.sensor" value="{{system.sensor}}" />
        {{#if (ne system.effective.sensor system.sensor)}}<span class="stat-effective" title="With its modifications (base {{system.sensor}})">→ {{system.effective.sensor}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label>Autonav</label>
        <input type="number" name="system.autonav" value="{{system.autonav}}" />
        {{#if (ne system.effective.autonav system.autonav)}}<span class="stat-effective" title="With its modifications (base {{system.autonav}})">→ {{system.effective.autonav}}</span>{{/if}}
      </div>
      <div class="stat-item">
        <label title="Cargo Factor. The number after the arrow is what's still free once design options and every modification take their share (Rigger 2 p.113, p.115).">Cargo (CF)</label>
        <input type="number" name="system.cargo" value="{{system.cargo}}" step="0.5" />
        <span class="stat-effective" title="Free Cargo Factor">→ {{system.cargoFree}} free</span>
      </div>
      <div class="stat-item">
        <label title="Load in kg. The number after the arrow is what's still free (Rigger 2 p.113, p.115).">Load (kg)</label>
        <input type="number" name="system.load" value="{{system.load}}" />
        <span class="stat-effective" title="Free Load">→ {{system.loadFree}} free</span>
      </div>
    </div>
  </fieldset>

  <div class="vehicle-body flexrow">
    <fieldset>
      <legend>Condition</legend>
      <input type="number" name="system.conditionMonitor.value" value="{{system.conditionMonitor.value}}" min="0" max="{{system.conditionMonitor.max}}" />
      <span>/ {{system.conditionMonitor.max}}</span>
    </fieldset>

    <fieldset>
      <legend>Details</legend>
      <div class="form-group">
        <label>Seating:</label>
        <input type="text" name="system.seating" value="{{system.seating}}" />
      </div>
      <div class="form-group">
        <label>Cost:</label>
        <input type="number" name="system.cost" value="{{system.cost}}" />
      </div>
      <details class="vehicle-statline">
        <summary title="The rest of the Rigger 2 stat line (p.148 format)">More (entry, fuel, economy…)</summary>
        <div class="form-group"><label>Entry points:</label><input type="text" name="system.entryPoints" value="{{system.entryPoints}}" placeholder="e.g. 2+1t" /></div>
        <div class="form-group"><label>Fuel:</label>
          <input type="text" name="system.fuelType" value="{{system.fuelType}}" placeholder="gasoline" style="max-width:7em" />
          <input type="number" name="system.fuelSize" value="{{system.fuelSize}}" style="max-width:5em" />
          <input type="text" name="system.fuelUnit" value="{{system.fuelUnit}}" placeholder="liters" style="max-width:5em" /></div>
        <div class="form-group"><label>Economy:</label>
          <input type="number" name="system.economy" value="{{system.economy}}" step="0.01" style="max-width:5em" />
          <input type="text" name="system.economyUnit" value="{{system.economyUnit}}" placeholder="km/liter" style="max-width:6em" />
          <input type="text" name="system.economyIdle" value="{{system.economyIdle}}" placeholder="idle" style="max-width:8em" /></div>
        <div class="form-group"><label title="Landing/takeoff profile (aircraft)">L/T profile:</label><input type="text" name="system.ltProfile" value="{{system.ltProfile}}" /></div>
        <div class="form-group"><label title="Drones: setup/breakdown time">Setup:</label><input type="text" name="system.setupTime" value="{{system.setupTime}}" /></div>
        <div class="form-group"><label>Availability:</label><input type="text" name="system.availability" value="{{system.availability}}" /></div>
        <div class="form-group"><label>Street Index:</label><input type="number" name="system.streetIndex" value="{{system.streetIndex}}" step="0.05" /></div>
        <div class="form-group"><label title="The vehicle's Design Point Value (Rigger 2 vehicle list)">Design Points:</label><input type="number" name="system.designPointValue" value="{{system.designPointValue}}" /></div>
        <div class="form-group"><label>Other features:</label><input type="text" name="system.otherFeatures" value="{{system.otherFeatures}}" /></div>
        {{#if custGM}}
        <div class="form-group" title="For customization (Rigger 2 p.118): which class prices and limits apply. GM only.">
          <label>Class (GM):</label>
          <select name="system.design.category">{{selectOptions custGM.categories selected=custGM.category}}</select>
          {{#each custGM.traits}}<label class="checkbox"><input type="checkbox" data-action="toggleTrait" data-trait="{{key}}" {{#if on}}checked{{/if}} /> {{key}}</label>{{/each}}
        </div>
        <div class="form-group"><label title="Engine customization prices from the power plant's cost (Rigger 2 p.120); a production vehicle has none printed. GM only.">Power plant cost (GM):</label>
          <input type="number" name="system.plantCost" value="{{custGM.plantCost}}" min="0" placeholder="—" data-nullable /></div>
        {{/if}}
      </details>
    </fieldset>
  </div>

  <fieldset class="vehicle-mods">
    <legend class="flexrow">
      <span>Modifications</span>
      {{#if editable}}
      <button type="button" data-action="customize" class="btn-add" title="Buy and install modifications by the customization rules (Rigger 2 p.118)">
        <i class="fas fa-wrench"></i> Customize
      </button>
      <button type="button" data-action="addItem" data-type="vehicle_mod" class="btn-add" title="Add a modification">
        <i class="fas fa-plus"></i>
      </button>
      {{/if}}
    </legend>
    <div class="item-list">
      {{#each mods as |mod|}}
      <div class="item-row flexrow" data-item-id="{{mod.id}}" draggable="true">
        <span class="item-name"><i class="fas fa-wrench"></i> {{mod.name}}{{#if mod.stateLabel}} <em class="mod-state" title="{{mod.stateTitle}}">{{mod.stateLabel}}</em>{{/if}}</span>
        {{#if mod.canTest}}<button type="button" class="mod-step" data-action="installTest" title="Roll the Installation Test (Rigger 2 p.118)">Test</button>{{/if}}
        {{#if mod.canFinish}}<button type="button" class="mod-step" data-action="finishInstall" title="The installation time has passed: the modification works from now on">Finish</button>{{/if}}
        {{#if mod.rated}}{{#if editable}}
        <label class="item-rating" title="Rating">R <input type="number" data-field="system.rating" value="{{mod.rating}}" min="0" /></label>
        {{else}}<span class="item-meta">R{{mod.rating}}</span>{{/if}}{{/if}}
        <div class="item-controls">
          <a data-action="editItem" title="Edit"><i class="fas fa-edit"></i></a>
          <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </div>
      {{else}}
      <p class="empty-hint">No modifications. Drag a vehicle mod from a compendium onto this sheet, or use +.</p>
      {{/each}}
    </div>
  </fieldset>

  <fieldset class="vehicle-weapons">
    <legend class="flexrow">
      <span>Weapons</span>
      {{#if editable}}
      <button type="button" data-action="addItem" data-type="weapon" class="btn-add" title="Add a weapon">
        <i class="fas fa-plus"></i>
      </button>
      {{/if}}
    </legend>
    <div class="item-list">
      {{#each weapons as |wpn|}}
      <div class="item-row flexrow" data-item-id="{{wpn.id}}" draggable="true">
        <a class="item-name rollable" data-action="fireWeapon" title="Fire (Gunnery attack)"><i class="fas fa-crosshairs"></i> {{wpn.name}}</a>
        {{#if wpn.system.damageCode}}<span class="item-meta">{{wpn.system.damageCode}}</span>{{/if}}
        <div class="item-controls">
          <a data-action="fireWeapon" title="Fire (Gunnery attack)"><i class="fas fa-bullseye"></i></a>
          <a data-action="editItem" title="Edit"><i class="fas fa-edit"></i></a>
          <a data-action="deleteItem" title="Delete"><i class="fas fa-trash"></i></a>
        </div>
      </div>
      {{else}}
      <p class="empty-hint">No weapons mounted.</p>
      {{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend>Notes</legend>
    <div class="editor-content">{{{system.notes}}}</div>
    {{#if editable}}
    <textarea name="system.notes" style="display:none;">{{system.notes}}</textarea>
    {{/if}}
  </fieldset>
</section>
