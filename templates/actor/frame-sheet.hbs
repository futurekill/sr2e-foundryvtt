<section class="sr2e-matrix-sheet sr2e-frame-sheet">
  <header class="sr2e-matrix-header">
    <img src="{{actor.img}}" alt="{{actor.name}}" />
    <div class="title-block">
      <span class="actor-name">{{actor.name}}</span>
      <span class="subtitle">{{#ifEquals system.kind "sk"}}SK — MPCP {{system.coreRating}}{{else}}{{#ifEquals system.kind "smart"}}Smart{{else}}Dumb{{/ifEquals}} frame — Core {{system.coreRating}}{{/ifEquals}}</span>
    </div>
  </header>
  {{#if frame.state.ended}}<p class="rule-note" style="color:#c44;"><strong>Gone:</strong> {{frame.state.why}}.</p>{{/if}}
  {{#if frame.sk}}<p class="rule-note">A semi-autonomous knowbot (VR2.0 p.140–141): MPCP {{system.coreRating}}, Computer {{system.dinab}}.
    {{#if frame.sk.here}}On <strong>{{frame.sk.here}}</strong>{{else}}<strong>Between hosts</strong>{{/if}}; native host <strong>{{frame.sk.native}}</strong>.
    <br><strong>Utility Pool</strong> {{frame.sk.pool}}: {{frame.sk.used}} allocated, {{frame.sk.free}} free{{#if frame.sk.init}} (Initiative +{{frame.sk.init}}){{/if}}.
    {{#each frame.sk.items as |i|}}<br>{{i.name}}-{{i.rating}}{{#if i.level}} {{i.level}}{{/if}}{{/each}}
    {{#if frame.sk.isGM}}<br><button type="button" data-action="vr2ic" data-op="skAllocate" data-arg="" title="Allocate the Utility Pool: a Free Action (p.141)">Allocate…</button>
      {{#if frame.sk.here}}<button type="button" data-action="vr2ic" data-op="skLogoff" data-arg="" title="Leave this host: SKs can't jack out (p.141)">Graceful Logoff</button>
      {{else}}<button type="button" data-action="vr2ic" data-op="skLogon" data-arg="" title="Logon to Host; its native host needs no test (its passcode, p.140)">Logon to Host…</button>{{/if}}
      {{#if frame.sk.onNative}}{{#if frame.sk.damaged}}<button type="button" data-action="vr2ic" data-op="skRegenerate" data-arg="" title="On its native host: Medic or Restore at MPCP, no pool (a Complex Action, p.140)">Regenerate</button>{{/if}}{{/if}}{{/if}}</p>
  {{else}}<p class="rule-note">Running on <strong>{{frame.host}}</strong> for <strong>{{frame.owner}}</strong> (VR2.0 p.105–107).
    {{#ifEquals system.kind "dumb"}}A dumb frame crashes when its decker leaves this host.{{else}}A smart frame runs on whether its decker is logged on or not.{{/ifEquals}}</p>{{/if}}
  <div class="field-grid">
    <label class="field"><span>Bod</span><strong>{{frame.attrs.bod}}{{#ifEquals frame.attrs.bod system.bod}}{{else}} <small>of {{system.bod}}</small>{{/ifEquals}}</strong></label>
    <label class="field"><span>Evasion</span><strong>{{frame.attrs.evasion}}{{#ifEquals frame.attrs.evasion system.evasion}}{{else}} <small>of {{system.evasion}}</small>{{/ifEquals}}</strong></label>
    <label class="field"><span>Masking</span><strong>{{frame.attrs.masking}}{{#ifEquals frame.attrs.masking system.masking}}{{else}} <small>of {{system.masking}}</small>{{/ifEquals}}</strong></label>
    <label class="field"><span>Sensor</span><strong>{{frame.attrs.sensor}}{{#ifEquals frame.attrs.sensor system.sensor}}{{else}} <small>of {{system.sensor}}</small>{{/ifEquals}}</strong></label>
    {{#if system.dinab}}<label class="field" title="A smart frame's Computer skill; a dumb core's DINAB runs one program per action of its decker's, −1 when a run fails (p.103, p.106)"><span>DINAB</span><strong>{{frame.dinabLeft}}{{#ifEquals frame.dinabLeft system.dinab}}{{else}} <small>of {{system.dinab}}</small>{{/ifEquals}}</strong></label>{{/if}}
    {{#ifEquals system.kind "smart"}}<label class="field" title="Reaction = Core Rating; 1D6 + 1 per Initiative point (p.106)"><span>Initiative</span><strong>{{system.coreRating}} + {{frame.initDice}}D6</strong></label>{{/ifEquals}}
    {{#ifEquals system.kind "sk"}}<label class="field" title="Reaction = MPCP; 1D6, or 2/3/4D6 for 1/3/5 pool points (p.141)"><span>Initiative</span><strong>{{system.coreRating}} + {{frame.initDice}}D6</strong></label>{{/ifEquals}}
  </div>
  {{#if frame.smart}}<p class="rule-note"><strong>Its own tally</strong> on this host: {{frame.tally}}
    {{#if frame.order}}<br><strong>Order:</strong> {{frame.order}}{{/if}}
    {{#each frame.suppressions as |x|}}<br>Suppressing {{x.name}} (−1 Detection Factor) <button type="button" data-action="vr2ic" data-op="slowRelease" data-arg="{{x.arg}}"
      title="Release it: its rating goes on the tally (VR2.0 p.99)">Release</button>{{/each}}
    {{#if frame.canAct}}<br><button type="button" data-action="vr2ic" data-op="frameAct" data-arg=""
      title="The frame acts on its own: a System Operation, an attack, Scan Icon or a maneuver. Its DINAB is its skill; its own tally rises (VR2.0 p.107)."><i class="fas fa-terminal"></i> Act…</button>{{/if}}</p>{{/if}}
  <p class="rule-note"><strong>Condition</strong> (10 boxes, p.124):
    {{#each frame.boxes as |b|}}<i class="fas {{#if b}}fa-square{{else}}fa-square-o far fa-square{{/if}}"></i>{{/each}} {{frame.state.monitor}}/10</p>
  <p class="rule-note"><strong>Programs</strong> (object-code copies; they can't be changed):
    {{#each frame.programs as |p|}}<br>{{p.name}} {{p.effective}}{{#ifEquals p.effective p.rating}}{{else}} of {{p.rating}}{{/ifEquals}}{{#if p.crashed}} (crashed){{/if}}{{else}} none.{{/each}}</p>
  {{#if frame.triggers.length}}<p class="rule-note"><strong>Event triggers</strong> (VR2.0 p.107; the decker must be on this host to get the message):
    {{#each frame.triggers as |t|}}<br>{{t.note}} <em>({{t.watch}})</em>{{#if ../frame.isGM}} <button type="button" data-action="vr2ic" data-op="triggerFire" data-arg="{{../actor.id}}|{{t.key}}"
      title="The event happened: the frame reports it to its decker, if the frame can still see it and the decker is on this host.">Fire</button>{{/if}}{{/each}}</p>{{/if}}
</section>
