<section class="sr2e-npc-sheet">
  {{!-- Header --}}
  <div class="npc-header flexrow">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Click to change portrait" style="cursor:pointer;" class="profile-img" />
    <div class="header-info flexcol">
      <input type="text" name="name" value="{{actor.name}}" placeholder="NPC Name" />
      <div class="npc-details flexrow">
        <div class="form-group">
          <label>Race:</label>
          <input type="text" name="system.race" value="{{system.race}}" />
        </div>
        <div class="form-group">
          <label>Professional Rating:</label>
          <input type="number" name="system.professionalRating" value="{{system.professionalRating}}" min="0" max="6" />
        </div>
        <div class="form-group">
          <label>Threat Rating:</label>
          <input type="number" name="system.threatRating" value="{{system.threatRating}}" min="0" />
        </div>
        <div class="form-group">
          <label title="Present on both planes at once: fights and can be fought in astral space, keeping its Attributes and physical armor (SR2E p.148)">Dual-natured:</label>
          <input type="checkbox" name="system.dualNatured" {{checked system.dualNatured}} />
          {{#if system.dualNatured}}<button type="button" class="btn-small" data-action="astralAttack" title="Astral attack (SR2E p.147–148)"><i class="fas fa-hand-fist"></i> Astral</button>{{/if}}
        </div>
        {{#if system.awakened}}
        <div class="form-group">
          <label title="Physical → Perceiving → Projecting (SR2E p.145–147)">Astral:</label>
          <button type="button" class="btn-small astral-state {{system.astralState}}" data-action="toggleAstral">{{#ifEquals system.astralState "projecting"}}Projecting{{else}}{{#ifEquals system.astralState "perceiving"}}Perceiving{{else}}Physical{{/ifEquals}}{{/ifEquals}}</button>
          {{#unless (eq system.astralState "none")}}{{#unless system.dualNatured}}<button type="button" class="btn-small" data-action="astralAttack" title="Astral attack (SR2E p.147)"><i class="fas fa-hand-fist"></i> Astral</button>{{/unless}}{{/unless}}
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{!-- Forms and shapeshifting (core p.227–229; Companion p.37) --}}
  <fieldset class="npc-forms">
    <legend>Forms</legend>
    <div class="flexrow">
      <label title="Regeneration, Allergy (Severe) + Vulnerability to its bane, dual-natured (core p.227–229)">
        <input type="checkbox" name="system.shapeshifter.enabled" {{checked system.shapeshifter.enabled}} /> Shapeshifter</label>
      {{#if system.shapeshifter.enabled}}
      <label>Bane: <input type="text" name="system.shapeshifter.bane" value="{{system.shapeshifter.bane}}" style="max-width:6em" /></label>
      <button type="button" class="btn-small" data-action="regenerate" title="Out of combat: its wounds vanish (core p.227)"><i class="fas fa-heart-pulse"></i> Regenerate</button>
      {{#if shift.pending}}<span class="priority-warning" title="{{shift.death.why}}"><i class="fas fa-skull"></i> Death check (dies on {{#ifEquals shift.death.diesOn 1}}1{{else}}1–2{{/ifEquals}})</span>
        {{#if isGM}}<button type="button" class="btn-small" data-action="deathCheck" data-id="{{shift.death.id}}">Roll 1D6</button>
        {{#if shift.massiveOffer}}<button type="button" class="btn-small" data-action="deathCheck" data-id="{{shift.death.id}}" data-massive="1">Fire / explosion</button>{{/if}}{{/if}}{{/if}}
      {{#if shift.dead}}<span class="priority-warning"><i class="fas fa-skull"></i> Dead</span>{{/if}}
      {{#if isGM}}{{#each shift.magicOwed as |id|}}<button type="button" class="btn-small" data-action="deathMagic" data-id="{{id}}" title="Survived a Deadly wound (Companion p.38): 2D6 vs Magic (p.115)">Magic loss check</button>{{/each}}{{/if}}
      {{#if isGM}}{{#if shift.death}}<button type="button" class="btn-small" data-action="clearDeath">Clear</button>{{/if}}{{/if}}
      {{/if}}
      <button type="button" class="btn-small" data-action="addForm" title="Another stat block this creature can take"><i class="fas fa-plus"></i> Form</button>
    </div>
    {{#if shift.forms.length}}
    <div class="flexrow">
      <button type="button" class="btn-small{{#unless system.activeForm}} active{{/unless}}" data-action="shiftForm" data-form="" {{#if shift.problem}}disabled title="{{shift.problem}}"{{/if}}>Printed form</button>
      {{#each shift.forms as |f|}}
      <button type="button" class="btn-small{{#if f.active}} active{{/if}}" data-action="shiftForm" data-form="{{f.key}}" {{#if ../shift.problem}}disabled title="{{../shift.problem}}"{{/if}}>{{f.name}}</button>
      {{/each}}
    </div>
    <table class="npc-form-table">
      <tr><th>Name</th><th title="Tag weapons with this to limit them to the form">Key</th><th>B</th><th>Q</th><th>S</th><th>C</th><th>I</th><th>W</th><th title="Reaction modifier">R±</th><th title="Initiative dice">Init</th><th title="Ballistic / Impact">Armor</th><th>Art</th><th></th></tr>
      {{#each shift.forms as |f|}}
      <tr>
        <td><input type="text" value="{{f.name}}" data-form-index="{{f.i}}" data-form-field="name" /></td>
        <td><input type="text" value="{{f.key}}" data-form-index="{{f.i}}" data-form-field="key" /></td>
        <td><input type="number" value="{{f.body}}" min="0" data-form-index="{{f.i}}" data-form-field="body" /></td>
        <td><input type="number" value="{{f.quickness}}" min="0" data-form-index="{{f.i}}" data-form-field="quickness" /></td>
        <td><input type="number" value="{{f.strength}}" min="0" data-form-index="{{f.i}}" data-form-field="strength" /></td>
        <td><input type="number" value="{{f.charisma}}" min="0" data-form-index="{{f.i}}" data-form-field="charisma" /></td>
        <td><input type="number" value="{{f.intelligence}}" min="0" data-form-index="{{f.i}}" data-form-field="intelligence" /></td>
        <td><input type="number" value="{{f.willpower}}" min="0" data-form-index="{{f.i}}" data-form-field="willpower" /></td>
        <td><input type="number" value="{{f.reactionMod}}" data-form-index="{{f.i}}" data-form-field="reactionMod" /></td>
        <td><input type="number" value="{{f.initiativeDice}}" min="1" data-form-index="{{f.i}}" data-form-field="initiativeDice" /></td>
        <td><input type="number" value="{{f.ballistic}}" min="0" data-form-index="{{f.i}}" data-form-field="ballistic" />/<input type="number" value="{{f.impact}}" min="0" data-form-index="{{f.i}}" data-form-field="impact" /></td>
        <td><input type="text" value="{{f.img}}" placeholder="token art" data-form-index="{{f.i}}" data-form-field="img" /></td>
        <td><button type="button" class="btn-small" data-action="deleteForm" data-form-index="{{f.i}}" title="Delete form"><i class="fas fa-trash"></i></button></td>
      </tr>
      {{/each}}
    </table>
    <p class="hint">A weapon whose Form is a form's key is usable only in that form.{{#if shift.formLocked}} The stat block below shows the active form; shift back to edit it.{{/if}}</p>
    {{/if}}
  </fieldset>

  {{!-- Attributes --}}
  <fieldset class="npc-attributes">
    <legend>Attributes</legend>
    <div class="attr-grid">
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="body"
               title="Roll Body">B</label>
        <input type="number" name="system.body.base" value="{{system.body.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="quickness"
               title="Roll Quickness">Q</label>
        <input type="number" name="system.quickness.base" value="{{system.quickness.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="strength"
               title="Roll Strength">S</label>
        <input type="number" name="system.strength.base" value="{{system.strength.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="charisma"
               title="Roll Charisma">C</label>
        <input type="number" name="system.charisma.base" value="{{system.charisma.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="intelligence"
               title="Roll Intelligence">I</label>
        <input type="number" name="system.intelligence.base" value="{{system.intelligence.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="willpower"
               title="Roll Willpower">W</label>
        <input type="number" name="system.willpower.base" value="{{system.willpower.base}}" min="1"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
      </div>
      <div class="attr-item">
        <label title="Essence — critters may exceed 6 (vampires 2D6, shapeshifters 8; core p.217)">E</label>
        <input type="number" name="system.essence.value" value="{{system.essence.value}}" min="0" step="any" />
        {{#if (or system.essence.manualSigned (eq system.essence.manualSigned 0))}}<span class="hint" title="Signed Essence kept by hand (Cybertechnology)">signed (manual): {{system.essence.manualSigned}}</span>{{/if}}
      </div>
      <div class="attr-item">
        <label title="Body Index — total Body Cost of this NPC's bioware (Shadowtech p.6). Typed, not summed from items. Over natural Body ({{system.bodyIndex.max}}) it inflicts overstress: +1 TN per point on Body tests, and it raises the TN to magically heal this NPC by half its value.">BI</label>
        <input type="number" name="system.bodyIndex.value" value="{{system.bodyIndex.value}}" min="0" step="0.25" />
      </div>
      <div class="attr-item">
        <label class="attr-roll" data-action="rollAttribute" data-attribute="reaction"
               title="Roll Reaction">R</label>
        <span>{{system.reaction.value}}</span>
      </div>
    </div>
  </fieldset>

  <div class="npc-body flexrow">
    {{!-- Condition & Combat --}}
    <div class="npc-left flexcol">
      <fieldset>
        <legend>Condition</legend>
        <div class="monitor-row">
          <label>Physical:</label>
          <input type="number" name="system.conditionMonitor.physical.value" value="{{system.conditionMonitor.physical.value}}" min="0" max="{{system.conditionMonitor.physical.max}}" />
          <span>/ {{system.conditionMonitor.physical.max}}</span>
        </div>
        <div class="monitor-row">
          <label>Stun:</label>
          <input type="number" name="system.conditionMonitor.stun.value" value="{{system.conditionMonitor.stun.value}}" min="0" max="{{system.conditionMonitor.stun.max}}" />
          <span>/ {{system.conditionMonitor.stun.max}}</span>
        </div>
        {{> "systems/sr2e/templates/actor/parts/healing-clock.hbs"}}
      </fieldset>

      <fieldset>
        <legend>Armor</legend>
        {{!-- The inputs edit the stat-block BASE; derivation adds worn armor on
              top, so binding them to the total would re-add it on every edit. --}}
        <div class="flexrow">
          <label>B:</label>
          <input type="number" name="system.armor.ballistic" value="{{armorBase.ballistic}}" min="0"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
          <label>I:</label>
          <input type="number" name="system.armor.impact" value="{{armorBase.impact}}" min="0"  {{#if shift.formLocked}}disabled title="The active form sets this — shift back to edit"{{/if}} />
        </div>
        {{#if armorWorn}}
        <p class="rule-note">With worn armor: {{system.armor.ballistic}}/{{system.armor.impact}}</p>
        {{/if}}
      </fieldset>

      <fieldset>
        <legend>Initiative</legend>
        <div class="flexrow">
          <span>{{system.initiative.value}} + {{system.initiative.dice}}d6</span>
          <button type="button" data-action="rollInitiative" class="btn-small">
            <i class="fas fa-dice"></i> Roll
          </button>
        </div>
      </fieldset>
    </div>

    {{!-- Skills & Gear --}}
    <div class="npc-right flexcol">
      <fieldset>
        <legend>Skills</legend>
        {{#each skills as |skill|}}
        <div class="npc-skill-row flexrow" data-item-id="{{skill.id}}">
          <span class="rollable" data-action="rollSkill" title="Roll {{skill.name}}">{{skill.name}}</span>{{#unless skill.system._subRatingsSuppressed}}{{#if skill.system.concentration.name}}<span class="skill-conc-inline" data-action="rollSkill" data-variant="concentration" title="Concentration — roll {{skill.system.concentration.rating}} dice (SR2E p.70)"> ({{skill.system.concentration.name}} {{skill.system.concentration.rating}})</span>{{/if}}{{#if skill.system.specialization.name}}<span class="skill-spec-inline" data-action="rollSkill" data-variant="specialization" title="Specialization — roll {{skill.system.specialization.rating}} dice (SR2E p.70)"> [{{skill.system.specialization.name}} {{skill.system.specialization.rating}}]</span>{{/if}}{{/unless}}
          {{!-- A language rolls its derived rating, not the one bought (SR2E
                p.74) — show the number the dice will actually use. ponytail: no
                family chip here; NPC rows have no variant plumbing and a GM
                muddling through a related language can roll it off the PC side. --}}
          <span>{{#if skill.system.languageRating}}{{skill.system.languageRating}}{{else}}{{skill.system.rating}}{{/if}}</span>
          <a data-action="editItem"><i class="fas fa-edit"></i></a>
        </div>
        {{/each}}
        <button type="button" data-action="addItem" data-type="skill" class="btn-add btn-small">
          <i class="fas fa-plus"></i> Add Skill
        </button>
      </fieldset>

      <fieldset>
        <legend>Weapons</legend>
        {{#each weapons as |weapon|}}
        <div class="npc-weapon-row flexrow{{#if weapon.otherForm}} other-form{{/if}}" data-item-id="{{weapon.id}}">
          <span data-action="rollWeapon"{{#if weapon.otherForm}} title="Not usable in this form"{{/if}}>{{weapon.name}}{{#if weapon.otherForm}} <em>(other form)</em>{{/if}}</span>
          <span>{{weapon.system.damageCode}}</span>
          <a data-action="editItem"><i class="fas fa-edit"></i></a>
        </div>
        {{/each}}
        <button type="button" data-action="addItem" data-type="weapon" class="btn-add btn-small">
          <i class="fas fa-plus"></i> Add Weapon
        </button>
      </fieldset>

      {{!-- Spells. Only shown once an NPC actually has one, so ordinary NPCs are
            unchanged. Awakened NPCs are real in the books (Craft, Stone, Pride in
            Queen Euphoria) and their spells were previously prepared into context
            and then never rendered — invisible and uncastable. The sustain toggle
            is NOT optional: a successful sustained spell calls setSustaining(true)
            on its own, and setSustaining(false) is the only thing that removes the
            Active Effects it copied onto the caster. --}}
      {{#if spells.length}}
      <fieldset>
        <legend>Spells</legend>
        {{#each spells as |spell|}}
        <div class="npc-spell-row flexrow {{#if spell.system.sustaining}}sustaining{{/if}}" data-item-id="{{spell.id}}">
          <span data-action="castSpell" title="Cast this spell">
            <i class="fas fa-magic"></i> {{spell.name}}
            {{#if spell.system.sustaining}}
            <span class="sustain-badge" title="Sustained at Force {{spell.system.sustainedForce}}">F{{spell.system.sustainedForce}}</span>
            {{/if}}
          </span>
          <span>F{{spell.system.force}}</span>
          <span>{{spell.system.drainCode}}</span>
          <div class="item-controls">
            {{#ifEquals spell.system.duration "sustained"}}
            <a data-action="toggleSustain" class="sustain-toggle {{#if spell.system.sustaining}}active{{/if}}"
               title="{{#if spell.system.sustaining}}Drop spell (Free Action){{else}}Sustain (+2 TN on all other tests, SR2E p.130){{/if}}">
              <i class="fas fa-hourglass-half"></i>
            </a>
            {{/ifEquals}}
            <a data-action="editItem"><i class="fas fa-edit"></i></a>
          </div>
        </div>
        {{/each}}
        <button type="button" data-action="addItem" data-type="spell" class="btn-add btn-small">
          <i class="fas fa-plus"></i> Add Spell
        </button>
      </fieldset>
      {{/if}}

      {{#if cyberlimb.any}}
      <fieldset class="npc-cyberlimbs">
        <legend>Cyberlimbs</legend>
        {{> "systems/sr2e/templates/actor/parts/cyberlimbs.hbs"}}
      </fieldset>
      {{/if}}

      {{#if showDrugs}}
      <fieldset class="npc-drugs">
        <legend>Drugs</legend>
        {{#each drugs as |g|}}
        <div class="item-row flexrow" data-item-id="{{g.id}}">
          <span class="item-name">{{g.name}}</span><span>Doses: {{g.system.quantity}}</span>
          <div class="item-controls"><a data-action="useDose" title="Use a dose (Shadowtech)"><i class="fas fa-syringe"></i></a></div>
        </div>
        {{/each}}
        {{> "systems/sr2e/templates/actor/parts/substances.hbs"}}
        {{#if activeDrugs.length}}
    <div class="sr2e-active-drugs">
      <div class="category-header flexrow"><h3>Active drugs</h3></div>
      <div class="item-list">
        {{#each activeDrugs as |d|}}
        <div class="item-row flexrow" data-effect-id="{{d.id}}">
          <span class="item-name">{{d.name}}</span>
          <span class="hint {{#if d.expired}}drug-expired{{/if}}">{{d.label}}</span>
          <div class="item-controls">
            <a data-action="repostDrugCard" title="Re-post its card (if it isn't in chat)"><i class="fas fa-comment-medical"></i></a>
            <a data-action="endDrug" title="It has worn off — end its effects"><i class="fas fa-circle-xmark"></i></a>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
      </fieldset>
      {{/if}}

      {{!-- Foci. Read-only summary on purpose: the character magic tab has no
            active-toggle either, so activation happens on the item sheet via the
            edit control. A bonded, ACTIVE spell focus adds its Force to every
            spell the actor casts (FocusData doesn't bind a focus to a category),
            so the active state is worth showing plainly. --}}
      {{#if foci.length}}
      <fieldset>
        <legend>Foci</legend>
        {{#each foci as |focus|}}
        <div class="npc-focus-row flexrow" data-item-id="{{focus.id}}">
          <span>{{focus.name}}</span>
          <span>{{focus.system.focusType}}</span>
          <span>Force: {{focus.system.force}}</span>
          <span>{{#if focus.system.bonded}}Bonded{{else}}Unbonded{{/if}}{{#if focus.system.active}}, active{{/if}}</span>
          {{#if focus.system._unbound}}
            <span class="focus-bond warn" title="A specific spell focus serves ONE named spell (SR2E p.137). Until one is bound this focus grants no dice at all — open it and choose.">⚠ no spell bound</span>
          {{/if}}

          <div class="item-controls">
            <a data-action="editItem" title="Edit (bond / activate here)"><i class="fas fa-edit"></i></a>
          </div>
        </div>
        {{/each}}
      </fieldset>
      {{/if}}
    </div>
  </div>

  {{!-- Biography --}}
  <fieldset>
    <legend>Notes</legend>
    {{{enrichedBiography}}}
    {{#if editable}}
    <textarea name="system.biography" style="display:none;">{{system.biography}}</textarea>
    {{/if}}
  </fieldset>
</section>
