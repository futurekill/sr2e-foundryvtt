<section class="sr2e-spirit-sheet">
  <div class="spirit-header flexrow">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Click to change portrait" style="cursor:pointer;" class="profile-img" />
    <div class="header-info flexcol">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Spirit Name" />
      <div class="spirit-details flexrow">
        <div class="form-group">
          <label>Type:</label>
          <select name="system.spiritType">
            <option value="nature" {{selected system.spiritType "nature"}}>Nature Spirit</option>
            <option value="elemental" {{selected system.spiritType "elemental"}}>Elemental</option>
          </select>
        </div>
        <div class="form-group">
          <label>Force:</label>
          <input type="number" name="system.force" value="{{system.force}}" min="1" />
        </div>
        <div class="form-group">
          <label>{{#if isElemental}}Element{{else}}Domain{{/if}}:</label>
          <input type="text" name="system.domain" value="{{system.domain}}" />
        </div>
      </div>
      {{#if conjurerName}}
      <div class="spirit-conjurer hint">Bound to {{conjurerName}}</div>
      {{/if}}
    </div>
  </div>

  {{!-- Elemental sorcery services (SR2E p.141–142) --}}
  {{#if isElemental}}
  <fieldset class="spirit-services-box elemental-sorcery">
    <legend>Sorcery service <span class="hint">p.141–142</span></legend>
    <div class="flexrow" style="align-items:center;gap:8px;flex-wrap:wrap;">
      <span title="Aid Sorcery dice and sustained Combat Turns reduce its Force; a re-call restores it.">
        Force <strong>{{system.effectiveForce}}</strong> / {{system.force}}</span>
      <span class="hint" style="flex:1;">{{elementalStatus}}</span>
    </div>
    <div class="flexrow" style="gap:6px;margin-top:6px;flex-wrap:wrap;">
      {{#if system.pendingExpireSpellUuid}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="finishExpire"
              title="Finish ending the spell whose sustaining ran out">Finish ending the spell</button>
      {{else}}
      {{#ifEquals system.service "sustain"}}
      {{#if system.depleted}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="sustainTurn"
              title="Its Force is spent — the spell ends (p.142)">Expire now</button>
      {{else}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="sustainTurn"
              title="Counted automatically when its mage's combat moves to the next Combat Turn. Use this for time outside combat, or to correct a turn that was missed: its Force drops by 1; at 0 the spell ends (p.142).">−1 Combat Turn</button>
      {{#if system.sustainFreePending}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="consumeFree"
              title="The Combat Turn it took the spell over in is free; mark it passed if it was missed">Starting turn already passed</button>
      {{/if}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="takeOver"
              title="The mage takes the spell back — the +2 TN returns">Hand spell back</button>
      {{/if}}
      {{/ifEquals}}
      {{#ifEquals system.service "aid"}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="endService"
              title="End Aid Sorcery (its remaining Force stays)">End Aid Sorcery</button>
      {{/ifEquals}}
      {{#if system.depleted}}{{#unless system.service}}
      <button type="button" class="btn-small" data-action="elementalAction" data-kind="recall"
              title="Call it again: 1 service, back at full Force (p.141)">Re-call (1 service)</button>
      {{/unless}}{{/if}}
      {{/if}}
    </div>
  </fieldset>
  {{/if}}

  {{!-- Services --}}
  <fieldset class="spirit-services-box">
    <legend>Services</legend>
    <div class="flexrow" style="align-items:center;gap:6px;">
      <button type="button" class="monitor-btn" data-action="adjustServices" data-delta="-1">−</button>
      <span class="services-value" style="font-size:18px;font-weight:bold;">{{system.services}}</span>
      <span class="hint">/ {{system.maxServices}}</span>
      <button type="button" class="monitor-btn" data-action="adjustServices" data-delta="1">+</button>
      <span class="hint" style="flex:1;text-align:right;" title="Continuing one power, or one fight for the summoner, is a single service (p.140); + refunds a service when you rule so.">Each new use of a power costs 1 service</span>
    </div>
    <div class="flexrow spirit-service-status" style="align-items:center;gap:6px;margin-top:6px;flex-wrap:wrap;">
      <span class="hint" style="flex:1;"><strong>{{svc.label}}</strong>{{#if svc.fighting}} · fighting for its summoner{{/if}}</span>
      {{#if svc.controlled}}
      {{#if svc.fighting}}
      <button type="button" class="btn-small" data-action="standDown" title="The fight is over (free)">Stand down</button>
      {{else}}
      <button type="button" class="btn-small" data-action="fightForMe" title="Fight for its summoner: one service for the whole fight, however many foes (p.140)">Fight for me (1 service)</button>
      {{/if}}
      {{/if}}
    </div>
    {{#if isElemental}}{{#if svc.controlled}}
    <div class="flexrow" style="align-items:center;gap:6px;margin-top:6px;flex-wrap:wrap;">
      {{#if svc.present}}
      <span class="hint" style="flex:1;" title="Each 24 hours it hangs around or serves uses up a service (p.141)">Present {{svc.days}} full day(s) — each costs a service</span>
      {{#if svc.days}}<button type="button" class="btn-small" data-action="chargeDays">Charge day(s)</button>{{/if}}
      {{#unless (eq svc.status "engaged")}}<button type="button" class="btn-small" data-action="sendAway" title="Back to astral space, on notice (free); owed days are charged first">Send away</button>{{/unless}}
      {{else}}
      <span class="hint" style="flex:1;">{{#if svc.unknownPresence}}Present since unknown — send it away and call it to start the clock.{{else}}Away, on notice{{/if}}</span>
      {{#unless svc.unknownPresence}}<button type="button" class="btn-small" data-action="callElemental" title="Call it to serve (free, p.141): its 24-hour clock starts">Call</button>{{/unless}}
      {{/if}}
    </div>
    {{/if}}{{/if}}
    <div class="flexrow" style="align-items:center;gap:6px;margin-top:6px;">
      {{#if spiritPowers.length}}
      <select name="spiritPower" style="flex:1;">
        {{#each spiritPowers as |p|}}
        <option value="{{p.key}}">{{p.label}}</option>
        {{/each}}
      </select>
      <button type="button" class="btn-small" data-action="useSpiritPower">
        <i class="fas fa-bolt"></i> Use Power
      </button>
      {{else}}
      <span class="hint" style="flex:1;">No powers recorded for this spirit — set its domain, or add powers on the actor.</span>
      {{/if}}
    </div>
  </fieldset>

  <fieldset class="spirit-attributes">
    <legend>Attributes (derived from Force {{system.force}})</legend>
    <div class="attr-grid">
      <div class="attr-item"><label>B</label><span>{{system.body.value}}</span></div>
      <div class="attr-item"><label>Q</label><span>{{system.quickness.value}}</span></div>
      <div class="attr-item"><label>S</label><span>{{system.strength.value}}</span></div>
      <div class="attr-item"><label>C</label><span>{{system.charisma.value}}</span></div>
      <div class="attr-item"><label>I</label><span>{{system.intelligence.value}}</span></div>
      <div class="attr-item"><label>W</label><span>{{system.willpower.value}}</span></div>
      <div class="attr-item"><label>E</label><span>{{system.essence.value}}</span></div>
      <div class="attr-item"><label>R</label><span>{{system.reaction.value}}</span></div>
    </div>
    <div class="flexrow" style="gap:8px;margin-top:6px;">
      <button type="button" class="btn-small" data-action="rollInitiative">
        <i class="fas fa-dice-d6"></i> Initiative
      </button>
      <button type="button" class="btn-small" data-action="spiritAttack"
              title="Manifest attack: Force dice, ({{system.force}}){{#if isElemental}}S{{else}}M{{/if}}">
        <i class="fas fa-khanda"></i> Attack
      </button>
      <button type="button" class="btn-small" data-action="astralAttack"
              title="Astral attack: Force dice vs TN 4, opposed like melee; ({{system.force}})M (SR2E p.147)">
        <i class="fas fa-hand-fist"></i> Astral Attack
      </button>
    </div>
  </fieldset>

  <fieldset>
    <legend>Condition</legend>
    <div class="flexrow">
      <label>Physical:</label>
      <input type="number" name="system.conditionMonitor.physical.value" value="{{system.conditionMonitor.physical.value}}" min="0" max="{{system.conditionMonitor.physical.max}}" />
      <span>/ {{system.conditionMonitor.physical.max}}</span>
    </div>
    <div class="flexrow">
      <label>Stun:</label>
      <input type="number" name="system.conditionMonitor.stun.value" value="{{system.conditionMonitor.stun.value}}" min="0" max="{{system.conditionMonitor.stun.max}}" />
      <span>/ {{system.conditionMonitor.stun.max}}</span>
    </div>
  </fieldset>

  <fieldset>
    <legend>Notes</legend>
    <div class="editor-content">{{{system.notes}}}</div>
    {{#if editable}}
    <textarea name="system.notes" style="display:none;">{{system.notes}}</textarea>
    {{/if}}
  </fieldset>
</section>
