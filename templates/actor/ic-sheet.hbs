<section class="sr2e-matrix-sheet sr2e-ic-sheet">
  <header class="sr2e-matrix-header">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" title="Click to change portrait" style="cursor:pointer;" />
    <div class="title-block">
      <input type="text" name="name" value="{{actor.name}}" placeholder="IC Name" class="actor-name" />
      <span class="subtitle">{{localize (lookup config.icTypes system.icType)}}</span>
    </div>
    <div class="rating-badge">
      <span class="code">RATING</span>
      <span class="num">{{system.effectiveRating}}</span>
    </div>
  </header>

  <div class="field-grid">
    <label class="field">
      <span>Type</span>
      <select name="system.icType">
        {{#each config.icTypes as |label key|}}
        <option value="{{key}}" {{selected ../system.icType key}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label class="field">
      <span>Rating</span>
      <input type="number" name="system.rating" value="{{system.rating}}" min="1" />
    </label>
  </div>

  <fieldset class="node-link">
    <legend>Node</legend>
    <label class="field">
      <span>Defends Host</span>
      <select name="system.hostUuid" title="Link a Host node; its Security Code and alert sync to this IC automatically.">
        <option value="" {{#unless system.hostUuid}}selected{{/unless}}>— none (set manually) —</option>
        {{#each hosts as |host|}}
        <option value="{{host.uuid}}" {{selected ../system.hostUuid host.uuid}}>{{host.name}}</option>
        {{/each}}
      </select>
    </label>
    <div class="field-grid">
      <label class="field">
        <span>Node Code</span>
        <select name="system.securityCode" {{#if system.hostUuid}}disabled{{/if}}>
          {{#each config.securityCodes as |sec key|}}
          <option value="{{key}}" {{selected ../system.securityCode key}}>{{localize sec.label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="field">
        <span>Alert</span>
        <select name="system.alert" {{#if system.hostUuid}}disabled{{/if}}>
          {{#each config.alertStates as |label key|}}
          <option value="{{key}}" {{selected ../system.alert key}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    {{#if linkedHost}}
    <p class="rule-note"><i class="fas fa-link"></i> Code &amp; alert synced from <strong>{{linkedHost.name}}</strong>.</p>
    {{/if}}
    {{#if vr2}}
    <p class="rule-note">VR2.0: attacks roll the host's Security Value; Power = Rating, Level by Security Code (p.40, p.124).</p>
    {{else}}{{#ifEquals system.alert "none"}}{{else}}
    <p class="alert-note passive"><i class="fas fa-triangle-exclamation"></i> Alert — ratings boosted +50% (effective Rating {{system.effectiveRating}}, p.168).</p>
    {{/ifEquals}}{{/if}}
  </fieldset>

  {{#if vr2}}
  <fieldset>
    <legend>VR2.0 program (p.41, p.50)</legend>
    <div class="field-grid">
      <label class="field"><span>Program</span>
        <select name="system.program">
          <option value="" {{selected system.program ""}}>— (class as set)</option>
          {{#each config.icPrograms as |label key|}}<option value="{{key}}" {{selected ../system.program key}}>{{label}}</option>{{/each}}
        </select></label>
      <label class="field"><span>Defense</span>
        <select name="system.defense">
          <option value="" {{selected system.defense ""}}>—</option>
          <option value="shield" {{selected system.defense "shield"}}>Shield (+2 TN to hit)</option>
          <option value="shift" {{selected system.defense "shift"}}>Shift (+2 TN to hit)</option>
        </select></label>
      <label class="field"><span>Armor (−2 Power)</span>
        <input type="checkbox" name="system.armorDefense" {{checked system.armorDefense}} /></label>
    </div>
    <p class="rule-note">Class: <strong>{{system.icClass}}</strong>{{#if system.program}} (from the program){{/if}}.</p>
    <div class="field-grid">
      {{#ifEquals system.program "black-psychotropic"}}<label class="field"><span>Psychotropic effect (p.49)</span>
        <select name="system.psychotropic">{{#each config.icPsychotropic as |label key|}}<option value="{{key}}" {{selected ../system.psychotropic key}}>{{label}}</option>{{/each}}</select></label>{{/ifEquals}}
      {{#ifEquals system.program "scramble"}}<label class="field"><span>Scramble (p.42)</span>
        <select name="system.scramble">{{#each config.icScramble as |label key|}}<option value="{{key}}" {{selected ../system.scramble key}}>{{label}}</option>{{/each}}</select></label>
        <label class="field"><span>Linked data bomb (UUID)</span><input type="text" name="system.bombUuid" value="{{system.bombUuid}}" /></label>{{/ifEquals}}
      {{#ifEquals system.program "worm"}}<label class="field"><span>Worm (p.44)</span>
        <select name="system.worm">{{#each config.icWorm as |label key|}}<option value="{{key}}" {{selected ../system.worm key}}>{{label}}</option>{{/each}}</select></label>{{/ifEquals}}
      <label class="field" title="A reactive white or trace IC can hide a gray or black IC: crashing it (or its trace finishing) wakes that IC (p.50)."><span>Trap for (hidden IC's UUID)</span>
        <input type="text" name="system.trapFor" value="{{system.trapFor}}" /></label>
      <label class="field" title="What a data bomb, scramble or trap protects: a file, a slave device, a subsystem (p.41–42)."><span>Protects</span>
        <input type="text" name="system.protects" value="{{system.protects}}" /></label>
    </div>
    <div class="field-grid">
      <label class="field" title="Expert IC (p.52): + raises the attack dice and lowers damage resistance by as much; − the reverse. Proactive IC only."><span>Expert (−3…+3)</span>
        <input type="number" name="system.expert" value="{{system.expert}}" min="-3" max="3" {{#unless optionalIC.proactive}}disabled{{/unless}} /></label>
      <label class="field" title="Cascading IC (p.51): each miss adds 1 to the Security Value it attacks with; each hit the decker fully neutralizes adds 1 to its rating — up to the Cascading IC Table's cap. Proactive IC only."><span>Cascading</span>
        <input type="checkbox" name="system.cascading" {{checked system.cascading}} {{#unless optionalIC.proactive}}disabled{{/unless}} /></label>
    </div>
    {{#if optionalIC.cascade}}<p class="rule-note">Cascade now: Security Value +{{optionalIC.cascade.sv}}/{{optionalIC.cascade.capSV}}, rating +{{optionalIC.cascade.rating}}/{{optionalIC.cascade.capRating}}.
      {{#if isGM}}<button type="button" data-action="vr2ic" data-op="resetCascade" title="Start the cascade over (also happens when its program, rating or host changes, or it crashes).">Reset</button>{{/if}}</p>{{/if}}
    <p class="rule-note">{{#if optionalIC.party}}Party IC: {{optionalIC.party}} programs — +{{optionalIC.party}} TN on its attacks and to hit it (an area-effect utility ignores that; p.52).
      {{#if isGM}}<button type="button" data-action="vr2ic" data-op="leaveParty">Leave party</button>{{/if}}
      {{else}}{{#if isGM}}<button type="button" data-action="vr2ic" data-op="formParty" title="Select the other IC tokens on the canvas, then form a party with this one (p.52–53).">Form party IC with selected</button>{{/if}}{{/if}}</p>
    {{#if (or (eq system.program "tar-baby") (eq system.program "tar-pit"))}}<p class="rule-note">
      <button type="button" data-action="vr2ic" data-op="strike" title="GM: target the decker first, then strike a utility they run outside a System Test (p.42).">Strike a utility</button></p>{{/if}}
  </fieldset>
  {{/if}}

  <fieldset>
    <legend>Persona Attributes</legend>
    <div class="attr-grid">
      <label class="attr"><span>Bod</span><input type="number" name="system.bod" value="{{system.bod}}" min="0" /></label>
      <label class="attr"><span>Evasion</span><input type="number" name="system.evasion" value="{{system.evasion}}" min="0" /></label>
      <label class="attr"><span>Masking</span><input type="number" name="system.masking" value="{{system.masking}}" min="0" /></label>
      <label class="attr"><span>Sensor</span><input type="number" name="system.sensor" value="{{system.sensor}}" min="0" /></label>
      <label class="attr"><span>Attack</span><input type="number" name="system.attack" value="{{system.attack}}" min="0" /></label>
    </div>
  </fieldset>

  <div class="stat-row">
    <div class="stat">
      <span class="stat-label">Condition</span>
      <span class="stat-value">
        <input type="number" name="system.conditionMonitor.value" value="{{system.conditionMonitor.value}}" min="0" max="{{system.conditionMonitor.max}}" />
        <span>/ {{system.conditionMonitor.max}}</span>
      </span>
    </div>
    <div class="stat">
      <span class="stat-label">Initiative</span>
      <span class="stat-value">{{system.initiative.value}} + {{system.initiative.dice}}d6</span>
    </div>
  </div>

  <div class="ic-action-row">
    <button type="button" class="matrix-attack-btn" data-action="matrixAttack" title="Attack a persona in the Matrix (IC Rating dice vs the target's Bod, SR2E p.178).">
      <i class="fas fa-bolt"></i> Matrix Attack
    </button>
    {{#if vr2}}
    <button type="button" class="matrix-attack-btn" data-action="vr2Maneuver" title="Evade, parry or position against the targeted persona: the host's Security Value, opposed by its Sensor (VR2.0 p.122).">
      <i class="fas fa-shuffle"></i> Maneuver
    </button>
    <button type="button" class="matrix-attack-btn" data-action="vr2Redetect" title="Find the icons that evaded this IC again (the GM's call, e.g. out of combat; VR2.0 p.122).">
      <i class="fas fa-eye"></i> Re-detect
    </button>
    {{/if}}
    {{#unless vr2}}
    <button type="button" class="matrix-attack-btn" data-action="matrixPerception" title="Scan for an intruder: IC Rating vs the persona's Masking; any success raises the alert (SR2E p.169).">
      <i class="fas fa-magnifying-glass"></i> Detect Intruder
    </button>
    {{/unless}}
  </div>

  <fieldset>
    <legend>Notes</legend>
    <div class="editor-content">{{{system.notes}}}</div>
    {{#if editable}}
    <textarea name="system.notes" style="display:none;">{{system.notes}}</textarea>
    {{/if}}
  </fieldset>
</section>
